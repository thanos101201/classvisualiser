{"method":{"methodHash":"f8635972fb9d6545e99d26a442228d65","typeHash":"cd7f796341d141a5e5c575e726bb4c17","name":"CompareVersions","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/Other/UpdateManager.cs","bodySpan":{"startLine":18,"startColumn":9,"endLine":38,"endColumn":10},"calls":[{"span":{"startLine":23,"startColumn":34,"endLine":23,"endColumn":68},"calleeMethodHash":null,"calleeDisplayName":"TrimStart"},{"span":{"startLine":24,"startColumn":33,"endLine":24,"endColumn":66},"calleeMethodHash":null,"calleeDisplayName":"TrimStart"},{"span":{"startLine":27,"startColumn":31,"endLine":27,"endColumn":60},"calleeMethodHash":null,"calleeDisplayName":"Parse"},{"span":{"startLine":28,"startColumn":30,"endLine":28,"endColumn":58},"calleeMethodHash":null,"calleeDisplayName":"Parse"},{"span":{"startLine":30,"startColumn":24,"endLine":30,"endColumn":49},"calleeMethodHash":null,"calleeDisplayName":"CompareTo"},{"span":{"startLine":36,"startColumn":24,"endLine":36,"endColumn":105},"calleeMethodHash":null,"calleeDisplayName":"Compare"}]},"lines":["        private int CompareVersions(string currentVersion, string latestVersion)","        {","            try","            {","                // Remove \u0027v\u0027 prefix if present","                currentVersion = currentVersion.TrimStart(\u0027v\u0027, \u0027V\u0027);","                latestVersion = latestVersion.TrimStart(\u0027v\u0027, \u0027V\u0027);","","                // Parse versions","                var current = Version.Parse(currentVersion);","                var latest = Version.Parse(latestVersion);","","                return current.CompareTo(latest);","            }","            catch (Exception ex)","            {","","                // Fallback to string comparison if parsing fails","                return string.Compare(currentVersion, latestVersion, StringComparison.OrdinalIgnoreCase);","            }","        }"],"startLine":18}
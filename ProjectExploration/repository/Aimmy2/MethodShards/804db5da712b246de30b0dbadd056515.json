nInvoke(() =\u003E","                    Dictionary.FOVWindow.FOVStrictEnclosure.Margin = new Thickness(","                        Convert.ToInt16(displayRelativeX / WinAPICaller.scalingFactorX) - 320, // this is based off the window size, not the size of the model -whip","                        Convert.ToInt16(displayRelativeY / WinAPICaller.scalingFactorY) - 320, 0, 0));","            }","        }"],"startLine":682}
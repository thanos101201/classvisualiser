dToggle(\u0022UI TopMost\u0022, t =\u003E uiManager.T_UITopMost = t,","                    tooltip: \u0022Keep this window above all other windows.\u0022)","                .AddToggle(\u0022Debug Mode\u0022, t =\u003E uiManager.T_DebugMode = t,","                    tooltip: \u0022Show extra information useful for troubleshooting problems.\u0022)","                .AddButton(\u0022Save Config\u0022, b =\u003E","                {","                    uiManager.B_SaveConfig = b;","                    b.Reader.Click \u002B= (s, e) =\u003E new ConfigSaver().ShowDialog();","                }, tooltip: \u0022Save your current settings to a file you can load later.\u0022)","                .AddSeparator();","        }"],"startLine":227}
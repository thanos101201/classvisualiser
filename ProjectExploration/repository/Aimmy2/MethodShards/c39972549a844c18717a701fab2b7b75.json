{"method":{"methodHash":"c39972549a844c18717a701fab2b7b75","typeHash":"76fd280d7e01de4545983d9bd02a73bf","name":"IsMemoryIntegrityEnabled","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/Other/RequirementsManager.cs","bodySpan":{"startLine":27,"startColumn":9,"endLine":39,"endColumn":10},"calls":[{"span":{"startLine":32,"startColumn":29,"endLine":32,"endColumn":72},"calleeMethodHash":null,"calleeDisplayName":"GetValue"},{"span":{"startLine":33,"startColumn":34,"endLine":33,"endColumn":56},"calleeMethodHash":null,"calleeDisplayName":"ToInt32"},{"span":{"startLine":35,"startColumn":17,"endLine":35,"endColumn":146},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"}]},"lines":["        public static bool IsMemoryIntegrityEnabled() // false if enabled true if disabled, you want it disabled","        {","            //credits to Themida","            string keyPath = @\u0022HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforceCodeIntegrity\u0022;","            string valueName = \u0022Enabled\u0022;","            object? value = Registry.GetValue(keyPath, valueName, null);","            if (value != null \u0026\u0026 Convert.ToInt32(value) == 1)","            {","                LogManager.Log(LogManager.LogLevel.Warning, \u0022Memory Integrity is enabled, please disable it to use Logitech Driver.\u0022, true, 7000);","                return false;","            }","            else return true;","        }"],"startLine":27}
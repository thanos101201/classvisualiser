ame(file);","                    string destPath = Path.Combine(destDir, fileName);","","                    if (File.Exists(destPath))","                    {","                        string duplicatePath = Path.Combine(destDir, Path.GetFileNameWithoutExtension(fileName) \u002B \u0022-DUPLICATED\u0022 \u002B Path.GetExtension(fileName));","                        File.Move(file, duplicatePath);","                        new NoticeBar($\u0022Duplicate model renamed: {Path.GetFileName(duplicatePath)}\u0022, 3000).Show();","                        continue;","                    }","                    try","                    {","                        File.Move(file, destPath);","","                        var item = new ListBoxItem","                        {","                            Content = Path.GetFileName(destPath),","                            Tag = destPath","                        };","","                        ModelListBox.Items.Add(item);","                        new NoticeBar($\u0022Model moved: {Path.GetFileName(destPath)}\u0022, 3000).Show();","                    }","                    catch (Exception ex)","                    {","                        new NoticeBar($\u0022Error moving model: {ex.Message}\u0022, 5000).Show();","                    }","                }","            }","        }"],"startLine":258}
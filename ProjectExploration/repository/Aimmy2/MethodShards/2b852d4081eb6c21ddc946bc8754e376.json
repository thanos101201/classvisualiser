{"method":{"methodHash":"2b852d4081eb6c21ddc946bc8754e376","typeHash":"e4a6a66cfe6c7304f91b9ce2765912cc","name":"EstimateResourceScoreAtCap","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/PerformanceBenchmark.cs","bodySpan":{"startLine":409,"startColumn":9,"endLine":421,"endColumn":10},"calls":[{"span":{"startLine":414,"startColumn":28,"endLine":414,"endColumn":69},"calleeMethodHash":null,"calleeDisplayName":"Clamp"}]},"lines":["        private static double EstimateResourceScoreAtCap(PerformanceBenchmarkSizeResult result, int cap)","        {","            if (result.AverageFps \u003C= 0)","                return double.MaxValue;","","            double scale = Math.Clamp(cap / result.AverageFps, 0, 1);","            double estimatedCpu = result.AverageCpuPercent * scale;","            if (!result.GpuAvailable)","                return estimatedCpu;","","            double estimatedGpu = result.AverageGpuPercent * scale;","            return estimatedGpu * 2 \u002B estimatedCpu;","        }"],"startLine":409}
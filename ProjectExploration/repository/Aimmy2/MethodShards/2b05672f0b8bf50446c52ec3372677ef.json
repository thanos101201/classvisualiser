olumn":23,"endLine":113,"endColumn":67},"calleeMethodHash":"da259766c80410d95117b9d2d4520b04","calleeDisplayName":"InputLogic.MovementPaths.Lerp(double, double, double)"},{"span":{"startLine":112,"startColumn":28,"endLine":112,"endColumn":59},"calleeMethodHash":"30d3584f05026de071468710f82da81b","calleeDisplayName":"InputLogic.MovementPaths.Grad(int, double, double)"},{"span":{"startLine":113,"startColumn":28,"endLine":113,"endColumn":63},"calleeMethodHash":"30d3584f05026de071468710f82da81b","calleeDisplayName":"InputLogic.MovementPaths.Grad(int, double, double)"}]},"lines":["        private static double Noise(double x, double y)","        {","            int X = (int)Math.Floor(x) \u0026 255;","            int Y = (int)Math.Floor(y) \u0026 255;","","            x -= Math.Floor(x);","            y -= Math.Floor(y);","","            double u = Fade(x);","            double v = Fade(y);","","            int A = permutation[X] \u002B Y;","            int AA = permutation[A];","            int AB = permutation[A \u002B 1];","            int B = permutation[X \u002B 1] \u002B Y;","            int BA = permutation[B];","            int BB = permutation[B \u002B 1];","","            return Lerp(Lerp(Grad(permutation[AA], x, y),","                           Grad(permutation[BA], x - 1, y), u),","                      Lerp(Grad(permutation[AB], x, y - 1),","                           Grad(permutation[BB], x - 1, y - 1), u), v);","        }"],"startLine":92}
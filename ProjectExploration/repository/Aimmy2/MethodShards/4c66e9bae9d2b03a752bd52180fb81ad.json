ing.Point, System.Drawing.Point, double)"},{"span":{"startLine":187,"startColumn":38,"endLine":187,"endColumn":93},"calleeMethodHash":"eb1c7702e1b0ba9cf47e49b362b532f7","calleeDisplayName":"InputLogic.MouseManager.EmaSmoothing(double, double, double)"},{"span":{"startLine":188,"startColumn":38,"endLine":188,"endColumn":93},"calleeMethodHash":"eb1c7702e1b0ba9cf47e49b362b532f7","calleeDisplayName":"InputLogic.MouseManager.EmaSmoothing(double, double, double)"},{"span":{"startLine":191,"startColumn":29,"endLine":191,"endColumn":65},"calleeMethodHash":null,"calleeDisplayName":"Clamp"},{"span":{"startLine":192,"startColumn":29,"endLine":192,"endColumn":65},"calleeMethodHash":null,"calleeDisplayName":"Clamp"},{"span":{"startLine":202,"startColumn":21,"endLine":202,"endColumn":100},"calleeMethodHash":"2417ac06a09b9a2722ddf05c085f33cb","calleeDisplayName":"MouseMovementLibraries.SendInputSupport.SendInputMouse.SendMouseCommand(uint, int, int)"},{"span":{"startLine":206,"startColumn":21,"endLine":206,"endColumn":69},"calleeMethodHash":"7e56eaee65019eead8c736f1614dac1d","calleeDisplayName":"Aimmy2.MouseMovementLibraries.GHubSupport.LGMouse.Move(int, int, int, int)"},{"span":{"startLine":210,"startColumn":21,"endLine":210,"endColumn":75},"calleeMethodHash":"557b4672e31f93938e4520e59792ed91","calleeDisplayName":"MouseMovementLibraries.RazerSupport.RZMouse.mouse_move(int, int, bool)"},{"span":{"startLine":214,"startColumn":21,"endLine":214,"endColumn":82},"calleeMethodHash":"584c4e44cff02fdf8a576ad18f501e15","calleeDisplayName":"MouseMovementLibraries.ddxoftSupport.ddxoftMouse.pDD_movR.Invoke(int, int)"},{"span":{"startLine":218,"startColumn":21,"endLine":218,"endColumn":98},"calleeMethodHash":"e07e2c18c48be18420326d78ac54c69c","calleeDisplayName":"InputLogic.MouseManager.mouse_event(uint, uint, uint, uint, int)"},{"span":{"startLine":227,"startColumn":17,"endLine":227,"endColumn":34},"calleeMethodHash":"965a6272ae15c3c3b4c86d34d5c074c8","calleeDisplayName":"InputLogic.MouseManager.ResetSprayState()"}]},"lines":["        public static void MoveCrosshair(int detectedX, int detectedY)","        {","            int halfScreenWidth = (int)ScreenWidth / 2;","            int halfScreenHeight = (int)ScreenHeight / 2;","","            int targetX = detectedX - halfScreenWidth;","            int targetY = detectedY - halfScreenHeight;","","            double aspectRatioCorrection = ScreenWidth / ScreenHeight;","","            int MouseJitter = AimSettings.MouseJitter;","            int jitterX = MouseRandom.Next(-MouseJitter, MouseJitter);","            int jitterY = MouseRandom.Next(-MouseJitter, MouseJitter);","","            Point start = new(0, 0);","            Point end = new(targetX, targetY);","            Point newPosition = new Point(0, 0);","","            switch (AimSettings.MovementPath)","            {","                case \u0022Cubic Bezier\u0022:","                    Point control1 = new Point(start.X \u002B (end.X - start.X) / 3, start.Y \u002B (end.Y - start.Y) / 3);","                    Point control2 = new Point(start.X \u002B 2 * (end.X - start.X) / 3, start.Y \u002B 2 * (end.Y - start.Y) / 3);","                    newPosition = MovementPaths.CubicBezier(start, end, control1, control2, 1 - AimSettings.MouseSensitivity);","                    break;","                case \u0022Linear\u0022:","                    newPosition = MovementPaths.Lerp(start, end, 1 - AimSettings.MouseSensitivity);","                    break;","                case \u0022Exponential\u0022:","                    newPosition = MovementPaths.Exponential(start, end, 1 - (AimSettings.MouseSensitivity - 0.2), 3.0);","                    break;","                case \u0022Adaptive\u0022:","                    newPosition = MovementPaths.Adaptive(start, end, 1 - AimSettings.MouseSensitivity);","                    break;","                case \u0022Perlin Noise\u0022:","                    newPosition = MovementPaths.PerlinNoise(start, end, 1 - AimSettings.MouseSensitivity, 20, 0.5);","                    break;","                default:","                    newPosition = MovementPaths.Lerp(start, end, 1 - AimSettings.MouseSensitivity);","                    break;","            }","","            if (IsEMASmoothingEnabled)","            {","                newPosition.X = (int)EmaSmoothing(previousX, newPosition.X, smoothingFactor);","                newPosition.Y = (int)EmaSmoothing(previousY, newPosition.Y, smoothingFactor);","            }","","            newPosition.X = Math.Clamp(newPosition.X, -150, 150);","            newPosition.Y = Math.Clamp(newPosition.Y, -150, 150);","","            newPosition.Y = (int)(newPosition.Y / aspectRatioCorrection);","","            newPosition.X \u002B= jitterX;","            newPosition.Y \u002B= jitterY;","","            switch (AimSettings.MouseMovementMethod)","            {","                case \u0022SendInput\u0022:","                    SendInputMouse.SendMouseCommand(MOUSEEVENTF_MOVE, newPosition.X, newPosition.Y);","                    break;","","                case \u0022LG HUB\u0022:","                    LGMouse.Move(0, newPosition.X, newPosition.Y, 0);","                    break;","","                case \u0022Razer Synapse (Require Razer Peripheral)\u0022:","                    RZMouse.mouse_move(newPosition.X, newPosition.Y, true);","                    break;","","                case \u0022ddxoft Virtual Input Driver\u0022:","                    DdxoftMain.ddxoftInstance.movR!(newPosition.X, newPosition.Y);","                    break;","","                default:","                    mouse_event(MOUSEEVENTF_MOVE, (uint)newPosition.X, (uint)newPosition.Y, 0, 0);","                    break;","            }","","            previousX = newPosition.X;","            previousY = newPosition.Y;","","            if (!AimSettings.AutoTrigger)","            {","                ResetSprayState();","            }","        }"],"startLine":143}
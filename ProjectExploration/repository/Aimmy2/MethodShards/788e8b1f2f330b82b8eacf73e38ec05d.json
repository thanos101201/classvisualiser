{"method":{"methodHash":"788e8b1f2f330b82b8eacf73e38ec05d","typeHash":"8969219cf55d3ac289412c4996ca8c5e","name":"DoTriggerClick","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/InputLogic/MouseManager.cs","bodySpan":{"startLine":69,"startColumn":9,"endLine":113,"endColumn":10},"calls":[{"span":{"startLine":72,"startColumn":19,"endLine":72,"endColumn":70},"calleeMethodHash":"749cfdac1cfb4a4588ace6e0c3112ffc","calleeDisplayName":"InputLogic.InputBindingManager.IsHoldingBinding(string)"},{"span":{"startLine":72,"startColumn":74,"endLine":72,"endColumn":132},"calleeMethodHash":"749cfdac1cfb4a4588ace6e0c3112ffc","calleeDisplayName":"InputLogic.InputBindingManager.IsHoldingBinding(string)"},{"span":{"startLine":74,"startColumn":17,"endLine":74,"endColumn":34},"calleeMethodHash":"965a6272ae15c3c3b4c86d34d5c074c8","calleeDisplayName":"InputLogic.MouseManager.ResetSprayState()"},{"span":{"startLine":83,"startColumn":38,"endLine":83,"endColumn":70},"calleeMethodHash":"b064e94e11516ef0a867081d39dae20d","calleeDisplayName":"Class.WinAPICaller.GetCursorPosition()"},{"span":{"startLine":85,"startColumn":51,"endLine":85,"endColumn":102},"calleeMethodHash":null,"calleeDisplayName":"Contains"},{"span":{"startLine":87,"startColumn":41,"endLine":87,"endColumn":61},"calleeMethodHash":"b65fb5784ee48d4a358de6bd60239695","calleeDisplayName":"InputLogic.MouseManager.ReleaseMouseButton()"},{"span":{"startLine":92,"startColumn":34,"endLine":92,"endColumn":51},"calleeMethodHash":"544175bbfe7f1ce7fa0efeaa93191189","calleeDisplayName":"InputLogic.MouseManager.HoldMouseButton()"},{"span":{"startLine":106,"startColumn":40,"endLine":106,"endColumn":57},"calleeMethodHash":"ee84085cea3c1072c2edacc1a1dbc14a","calleeDisplayName":"InputLogic.MouseManager.GetMouseActions()"},{"span":{"startLine":108,"startColumn":13,"endLine":108,"endColumn":31},"calleeMethodHash":null,"calleeDisplayName":"Invoke"},{"span":{"startLine":109,"startColumn":19,"endLine":109,"endColumn":53},"calleeMethodHash":null,"calleeDisplayName":"Delay"},{"span":{"startLine":110,"startColumn":13,"endLine":110,"endColumn":29},"calleeMethodHash":null,"calleeDisplayName":"Invoke"}]},"lines":["        public static async Task DoTriggerClick(RectangleF? detectionBox = null)","        {","            // there was a toggle for this, but i realized if it was off, it would never stop spraying. - T","            if (!(InputBindingManager.IsHoldingBinding(\u0022Aim Keybind\u0022) || InputBindingManager.IsHoldingBinding(\u0022Second Aim Keybind\u0022)))","            {","                ResetSprayState();","                return;","            }","","","            if (AimSettings.SprayMode)","            {","                if (AimSettings.CursorCheck)","                {","                    Point mousePos = WinAPICaller.GetCursorPosition();","","                    if (detectionBox.HasValue \u0026\u0026 !detectionBox.Value.Contains(mousePos.X, mousePos.Y))","                    {","                        if (isSpraying) ReleaseMouseButton();","                        return;","                    }","                }","","                if (!isSpraying) HoldMouseButton();","                return;","            }","","            // Single click logic if spray mode off","            int timeSinceLastClick = (int)(DateTime.UtcNow - LastClickTime).TotalMilliseconds;","            int triggerDelayMilliseconds = AimSettings.AutoTriggerDelayMilliseconds;","            const int clickDelayMilliseconds = 20;","","            if (timeSinceLastClick \u003C triggerDelayMilliseconds \u0026\u0026 LastClickTime != DateTime.MinValue)","            {","                return;","            }","","            var (mouseDown, mouseUp) = GetMouseActions();","","            mouseDown.Invoke();","            await Task.Delay(clickDelayMilliseconds);","            mouseUp.Invoke();","","            LastClickTime = DateTime.UtcNow;","        }"],"startLine":69}
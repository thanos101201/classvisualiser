em.Text.Json.JsonSerializer.Deserialize\u003CDictionary\u003Cstring, object\u003E\u003E(content);","","            string tagName = data[\u0022tag_name\u0022].ToString() ?? throw new InvalidOperationException(\u0022Tag name is missing in the response\u0022);","            string downloadUrl = ((JsonElement)data[\u0022assets\u0022]).EnumerateArray().First().GetProperty(\u0022browser_download_url\u0022).ToString();","","            return (tagName, downloadUrl);","        }"],"startLine":23}
{"method":{"methodHash":"b48b29437d7fe68adaa1d63d3db74155","typeHash":"e212d1e8cf791118b97599dbc2bd3f34","name":"HsvToRgb","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/UILibrary/AColorWheel.xaml.cs","bodySpan":{"startLine":355,"startColumn":9,"endLine":375,"endColumn":10},"calls":[{"span":{"startLine":358,"startColumn":35,"endLine":358,"endColumn":55},"calleeMethodHash":null,"calleeDisplayName":"Floor"},{"span":{"startLine":368,"startColumn":32,"endLine":368,"endColumn":54},"calleeMethodHash":null,"calleeDisplayName":"FromRgb"},{"span":{"startLine":369,"startColumn":32,"endLine":369,"endColumn":54},"calleeMethodHash":null,"calleeDisplayName":"FromRgb"},{"span":{"startLine":370,"startColumn":32,"endLine":370,"endColumn":54},"calleeMethodHash":null,"calleeDisplayName":"FromRgb"},{"span":{"startLine":371,"startColumn":32,"endLine":371,"endColumn":54},"calleeMethodHash":null,"calleeDisplayName":"FromRgb"},{"span":{"startLine":372,"startColumn":32,"endLine":372,"endColumn":54},"calleeMethodHash":null,"calleeDisplayName":"FromRgb"},{"span":{"startLine":373,"startColumn":33,"endLine":373,"endColumn":55},"calleeMethodHash":null,"calleeDisplayName":"FromRgb"}]},"lines":["        private Color HsvToRgb(double hue, double saturation, double value)","        {","            int hi = (int)(hue / 60) % 6;","            double f = hue / 60 - Math.Floor(hue / 60);","","            value = value * 255;","            byte v = (byte)value;","            byte p = (byte)(value * (1 - saturation));","            byte q = (byte)(value * (1 - f * saturation));","            byte t = (byte)(value * (1 - (1 - f) * saturation));","","            switch (hi)","            {","                case 0: return Color.FromRgb(v, t, p);","                case 1: return Color.FromRgb(q, v, p);","                case 2: return Color.FromRgb(p, v, t);","                case 3: return Color.FromRgb(p, q, v);","                case 4: return Color.FromRgb(t, p, v);","                default: return Color.FromRgb(v, p, q);","            }","        }"],"startLine":355}
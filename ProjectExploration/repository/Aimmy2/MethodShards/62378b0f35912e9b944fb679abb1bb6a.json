{"method":{"methodHash":"62378b0f35912e9b944fb679abb1bb6a","typeHash":"bc368f82a5d9e377a3601cdccaf62ec7","name":"UpdateDetection","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/PredictionManager.cs","bodySpan":{"startLine":152,"startColumn":9,"endLine":189,"endColumn":10},"calls":[{"span":{"startLine":171,"startColumn":18,"endLine":171,"endColumn":44},"calleeMethodHash":null,"calleeDisplayName":"Clamp"}]},"lines":["        public void UpdateDetection(WTFDetection detection)","        {","            var now = DateTime.UtcNow;","","            if (!_initialized)","            {","                _emaX = detection.X;","                _emaY = detection.Y;","                _prevX = detection.X;","                _prevY = detection.Y;","                _velocityX = 0;","                _velocityY = 0;","                _lastUpdateTime = now;","                _initialized = true;","                return;","            }","","            // Calculate time delta, clamped","            double dt = (now - _lastUpdateTime).TotalSeconds;","            dt = Math.Clamp(dt, 0.001, 0.1);","","            // Apply EMA to position","            _emaX = Alpha * detection.X \u002B (1.0 - Alpha) * _emaX;","            _emaY = Alpha * detection.Y \u002B (1.0 - Alpha) * _emaY;","","            // Calculate velocity (pixels per second)","            double newVelocityX = (_emaX - _prevX) / dt;","            double newVelocityY = (_emaY - _prevY) / dt;","","            // Apply EMA to velocity for smoothing","            _velocityX = Alpha * newVelocityX \u002B (1.0 - Alpha) * _velocityX;","            _velocityY = Alpha * newVelocityY \u002B (1.0 - Alpha) * _velocityY;","","            // Store for next frame","            _prevX = _emaX;","            _prevY = _emaY;","            _lastUpdateTime = now;","        }"],"startLine":152}
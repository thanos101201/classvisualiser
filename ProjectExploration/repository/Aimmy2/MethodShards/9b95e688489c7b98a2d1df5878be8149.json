{"method":{"methodHash":"9b95e688489c7b98a2d1df5878be8149","typeHash":"32dcfd1d62834e6a7a2852258e01a2ac","name":"GetSPY","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/PredictionManager.cs","bodySpan":{"startLine":279,"startColumn":9,"endLine":294,"endColumn":10},"calls":[{"span":{"startLine":290,"startColumn":34,"endLine":290,"endColumn":61},"calleeMethodHash":null,"calleeDisplayName":"Average"}]},"lines":["        public static int GetSPY()","        {","            if (!_initialized || _velocityYHistory.Count == 0)","            {","                return _prevY;","            }","","            // Get lead multiplier from settings","            double leadMultiplier = AimSettings.ShalloeLeadMultiplier;","","            // Calculate average velocity","            double avgVelocity = _velocityYHistory.Average();","","            // Predict future position: current \u002B (average velocity * lead multiplier)","            return (int)(_prevY \u002B avgVelocity * leadMultiplier);","        }"],"startLine":279}
s EMA Prediction\u0022] = 2","                }),","                (uiManager.D_DetectionAreaType, \u0022Detection Area Type\u0022, new Dictionary\u003Cstring, int\u003E","                {","                    [\u0022Closest to Center Screen\u0022] = 0,","                    [\u0022Closest to Mouse\u0022] = 1","                }),","                (uiManager.D_AimingBoundariesAlignment, \u0022Aiming Boundaries Alignment\u0022, new Dictionary\u003Cstring, int\u003E","                {","                    [\u0022Center\u0022] = 0,","                    [\u0022Top\u0022] = 1,","                    [\u0022Bottom\u0022] = 2","                }),","                // SettingsMenu dropdowns","                (uiManager.D_MouseMovementMethod, \u0022Mouse Movement Method\u0022, new Dictionary\u003Cstring, int\u003E","                {","                    [\u0022Mouse Event\u0022] = 0,","                    [\u0022SendInput\u0022] = 1,","                    [\u0022LG HUB\u0022] = 2,","                    [\u0022Razer Synapse (Require Razer Peripheral)\u0022] = 3,","                    [\u0022ddxoft Virtual Input Driver\u0022] = 4","                }),","                (uiManager.D_ScreenCaptureMethod, \u0022Screen Capture Method\u0022, new Dictionary\u003Cstring, int\u003E","                {","                    [\u0022DirectX\u0022] = 0,","                    [\u0022GDI\u002B\u0022] = 1","                }),","                (uiManager.D_ImageSize, \u0022Image Size\u0022, new Dictionary\u003Cstring, int\u003E","                {","                    [\u0022640\u0022] = 0,","                    [\u0022512\u0022] = 1,","                    [\u0022416\u0022] = 2,","                    [\u0022320\u0022] = 3,","                    [\u0022256\u0022] = 4,","                    [\u0022160\u0022] = 5","                }),","            };","","            foreach (var (dropdown, key, mappings) in dropdownConfigs)","            {","                if (dropdown == null)","                {","                    continue;","                }","","                if (Dictionary.dropdownState.TryGetValue(key, out var value))","                {","                    var stringValue = value?.ToString() ?? \u0022\u0022;","","                    if (mappings.TryGetValue(stringValue, out int index))","                    {","                        dropdown.DropdownBox.SelectedIndex = index;","                    }","                    else","                    {","                        LogManager.Log(LogManager.LogLevel.Warning, $\u0022No mapping found for \u0027{stringValue}\u0027 in \u0027{key}\u0027 dropdown.\u0022);","                    }","                }","            }","","            // Update slider visibility based on loaded states","            UpdatePredictionSliderVisibility();","            UpdateAimAssistSliderVisibility();","            UpdateAimConfigSliderVisibility();","        }"],"startLine":1066}
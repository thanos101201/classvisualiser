{"method":{"methodHash":"8af98a78af75709216a16ce6af955116","typeHash":"e212d1e8cf791118b97599dbc2bd3f34","name":"UpdateColorFromPosition","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/UILibrary/AColorWheel.xaml.cs","bodySpan":{"startLine":174,"startColumn":9,"endLine":213,"endColumn":10},"calls":[{"span":{"startLine":181,"startColumn":31,"endLine":181,"endColumn":59},"calleeMethodHash":null,"calleeDisplayName":"Sqrt"},{"span":{"startLine":186,"startColumn":32,"endLine":186,"endColumn":50},"calleeMethodHash":null,"calleeDisplayName":"Atan2"},{"span":{"startLine":187,"startColumn":22,"endLine":187,"endColumn":37},"calleeMethodHash":null,"calleeDisplayName":"Cos"},{"span":{"startLine":188,"startColumn":22,"endLine":188,"endColumn":37},"calleeMethodHash":null,"calleeDisplayName":"Sin"},{"span":{"startLine":193,"startColumn":13,"endLine":193,"endColumn":61},"calleeMethodHash":null,"calleeDisplayName":"SetLeft"},{"span":{"startLine":194,"startColumn":13,"endLine":194,"endColumn":60},"calleeMethodHash":null,"calleeDisplayName":"SetTop"},{"span":{"startLine":197,"startColumn":28,"endLine":197,"endColumn":46},"calleeMethodHash":null,"calleeDisplayName":"Atan2"},{"span":{"startLine":200,"startColumn":29,"endLine":200,"endColumn":83},"calleeMethodHash":"b48b29437d7fe68adaa1d63d3db74155","calleeDisplayName":"Aimmy2.UILibrary.AColorWheel.HsvToRgb(double, double, double)"},{"span":{"startLine":203,"startColumn":13,"endLine":203,"endColumn":46},"calleeMethodHash":"ade23c474134b1f0bd0bf2fc87d09824","calleeDisplayName":"Aimmy2.UILibrary.AColorWheel.UpdateColorPreview(Color)"},{"span":{"startLine":206,"startColumn":13,"endLine":206,"endColumn":39},"calleeMethodHash":"53f5a5fbaec07ac36d0033254c0441d2","calleeDisplayName":"Aimmy2.UILibrary.AColorWheel.UpdateBrightnessGradient()"}]},"lines":["        private void UpdateColorFromPosition(Point position)","        {","            double centerX = ColorWheelCanvas.Width / 2;","            double centerY = ColorWheelCanvas.Height / 2;","","            double dx = position.X - centerX;","            double dy = position.Y - centerY;","            double distance = Math.Sqrt(dx * dx \u002B dy * dy);","","            // Constrain to circle","            if (distance \u003E centerX)","            {","                double angle = Math.Atan2(dy, dx);","                dx = Math.Cos(angle) * centerX;","                dy = Math.Sin(angle) * centerX;","                distance = centerX;","            }","","            // Update selector position","            Canvas.SetLeft(ColorSelector, centerX \u002B dx - 10); // Adjusted for new selector size","            Canvas.SetTop(ColorSelector, centerY \u002B dy - 10);","","            // Calculate color","            _currentHue = (Math.Atan2(dy, dx) \u002B Math.PI) / (2 * Math.PI) * 360;","            _currentSaturation = distance / centerX;","","            _previewColor = HsvToRgb(_currentHue, _currentSaturation, _brightness);","","            // Update preview","            UpdateColorPreview(_previewColor);","","            // Update brightness gradient","            UpdateBrightnessGradient();","","            // Update the selector dot color","            if (ColorDot != null)","            {","                ColorDot.Fill = new SolidColorBrush(_previewColor);","            }","        }"],"startLine":174}
{"method":{"methodHash":"4f58ef3e43b519f9745869c51674ec7c","typeHash":"cd7f796341d141a5e5c575e726bb4c17","name":"CheckForUpdate","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/Other/UpdateManager.cs","bodySpan":{"startLine":40,"startColumn":9,"endLine":69,"endColumn":10},"calls":[{"span":{"startLine":43,"startColumn":55,"endLine":43,"endColumn":112},"calleeMethodHash":"f03d0f94bb69e45b6e1476c70eb0b7ee","calleeDisplayName":"Aimmy2.Other.GithubManager.GetLatestReleaseInfo(string, string)"},{"span":{"startLine":45,"startColumn":17,"endLine":45,"endColumn":52},"calleeMethodHash":null,"calleeDisplayName":"IsNullOrEmpty"},{"span":{"startLine":45,"startColumn":56,"endLine":45,"endColumn":90},"calleeMethodHash":null,"calleeDisplayName":"IsNullOrEmpty"},{"span":{"startLine":47,"startColumn":17,"endLine":47,"endColumn":121},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"},{"span":{"startLine":52,"startColumn":30,"endLine":52,"endColumn":76},"calleeMethodHash":"f8635972fb9d6545e99d26a442228d65","calleeDisplayName":"Other.UpdateManager.CompareVersions(string, string)"},{"span":{"startLine":56,"startColumn":17,"endLine":56,"endColumn":86},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"},{"span":{"startLine":61,"startColumn":17,"endLine":61,"endColumn":161},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"},{"span":{"startLine":66,"startColumn":13,"endLine":66,"endColumn":143},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"},{"span":{"startLine":67,"startColumn":13,"endLine":67,"endColumn":36},"calleeMethodHash":"94702319c76c3af13ef168322d13211f","calleeDisplayName":"Aimmy2.Other.GithubManager.Dispose()"},{"span":{"startLine":68,"startColumn":19,"endLine":68,"endColumn":41},"calleeMethodHash":"5d6a72d12622b3fcdeb01586c1c4d4df","calleeDisplayName":"Other.UpdateManager.DoUpdate(string)"}]},"lines":["        public async Task CheckForUpdate(string currentVersion)","        {","            GithubManager githubManager = new();","            var (latestVersion, latestZipUrl) = await githubManager.GetLatestReleaseInfo(\u0022Babyhamsta\u0022, \u0022Aimmy\u0022);","","            if (string.IsNullOrEmpty(latestVersion) || string.IsNullOrEmpty(latestZipUrl))","            {","                LogManager.Log(LogManager.LogLevel.Error, \u0022Failed to get latest release information from Github.\u0022, true);","                return;","            }","","            // Compare versions","            var comparison = CompareVersions(currentVersion, latestVersion);","","            if (comparison == 0)","            {","                LogManager.Log(LogManager.LogLevel.Info, \u0022You are up to date.\u0022, true);","                return;","            }","            else if (comparison \u003E 0)","            {","                LogManager.Log(LogManager.LogLevel.Info, $\u0022You are running a newer version ({currentVersion}) than the latest release ({latestVersion}).\u0022, true);","                return;","            }","","            // Only update if latest version is newer","            LogManager.Log(LogManager.LogLevel.Info, $\u0022A new version is available: {latestVersion}. Current version: {currentVersion}.\u0022, true);","            githubManager.Dispose();","            await DoUpdate(latestZipUrl);","        }"],"startLine":40}
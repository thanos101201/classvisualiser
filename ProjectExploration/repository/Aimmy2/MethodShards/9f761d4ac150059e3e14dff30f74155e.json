ileName(file);","                    string destPath = Path.Combine(destDir, fileName);","","                    if (File.Exists(destPath))","                    {","                        string duplicatePath = Path.Combine(destDir, Path.GetFileNameWithoutExtension(fileName) \u002B \u0022-DUPLICATED\u0022 \u002B Path.GetExtension(fileName));","                        File.Move(file, duplicatePath);","                        new NoticeBar($\u0022Duplicate config renamed: {Path.GetFileName(duplicatePath)}\u0022, 3000).Show();","                        continue;","                    }","","                    try","                    {","                        File.Move(file, destPath);","","                        var item = new ListBoxItem","                        {","                            Content = Path.GetFileName(destPath),","                            Tag = destPath","                        };","","                        ConfigsListBox.Items.Add(item);","                        new NoticeBar($\u0022Config moved: {Path.GetFileName(destPath)}\u0022, 3000).Show();","                    }","                    catch (Exception ex)","                    {","                        new NoticeBar($\u0022Error moving config: {ex.Message}\u0022, 5000).Show();","                    }","                }","            }","        }"],"startLine":318}
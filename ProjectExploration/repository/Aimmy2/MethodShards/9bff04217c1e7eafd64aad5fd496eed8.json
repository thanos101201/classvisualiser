l.Error, \u0022Model metadata does not contain \u0027names\u0027 field for classes.\u0022, true);","                }","                ClassesUpdated?.Invoke(new Dictionary\u003Cint, string\u003E(_modelClasses));","            }","            catch (Exception ex)","            {","                Log(LogLevel.Error, $\u0022Error loading classes: {ex.Message}\u0022, true);","            }","        }"],"startLine":424}
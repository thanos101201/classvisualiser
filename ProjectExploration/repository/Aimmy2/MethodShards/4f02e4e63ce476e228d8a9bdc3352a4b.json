{"method":{"methodHash":"4f02e4e63ce476e228d8a9bdc3352a4b","typeHash":"2ef589c6a7dfe65b491ee9bf8fb54ca9","name":"AddTrayIcon","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/Other/StreamGuardManager.cs","bodySpan":{"startLine":488,"startColumn":9,"endLine":532,"endColumn":10},"calls":[{"span":{"startLine":503,"startColumn":41,"endLine":503,"endColumn":65},"calleeMethodHash":null,"calleeDisplayName":"SizeOf"},{"span":{"startLine":514,"startColumn":34,"endLine":514,"endColumn":70},"calleeMethodHash":"dbbbd720e1ce9044addf5411c885b4bb","calleeDisplayName":"Aimmy2.Other.StreamGuardManager.LoadIcon(nint, nint)"},{"span":{"startLine":516,"startColumn":17,"endLine":516,"endColumn":88},"calleeMethodHash":"7fe5e56b4d9fd1babf3e0abfdd983b6e","calleeDisplayName":"Aimmy2.Other.StreamGuardManager.Shell_NotifyIcon(uint, ref Aimmy2.Other.StreamGuardManager.NOTIFYICONDATA)"},{"span":{"startLine":520,"startColumn":41,"endLine":520,"endColumn":84},"calleeMethodHash":null,"calleeDisplayName":"FromHwnd"},{"span":{"startLine":523,"startColumn":25,"endLine":523,"endColumn":48},"calleeMethodHash":null,"calleeDisplayName":"AddHook"},{"span":{"startLine":530,"startColumn":17,"endLine":530,"endColumn":93},"calleeMethodHash":null,"calleeDisplayName":"WriteLine"}]},"lines":["        private static void AddTrayIcon(Window window, nint hWnd)","        {","            try","            {","                if (_trayIconCreated \u0026\u0026 _mainApplicationHandle != nint.Zero)","                {","                    // this is the main menu, so don\u0027t create a new icon to avoid duplicates - just return lmfao, simple right?","                    if (hWnd != _mainApplicationHandle)","                        return;","                }","                else","                {","                    _mainApplicationHandle = hWnd;","                }","                NOTIFYICONDATA iconData = new NOTIFYICONDATA();","                iconData.cbSize = (uint)Marshal.SizeOf(iconData);","                iconData.hWnd = _mainApplicationHandle;","                iconData.uID = 1; // Fixed ID for single icon - must match RemoveTrayIcon pls","                iconData.uFlags = NIF_MESSAGE | NIF_ICON | NIF_TIP;","                iconData.uCallbackMessage = WM_USER \u002B 1;","                // Use a standard Windows icon (change the number to use different icons:","                // 32512 = Application, ","                // 32513 = Hand, ","                // 32514 = Question, ","                // 32515 = Exclamation, ","                // 32516 = Asterisk .. and so on)","                iconData.hIcon = LoadIcon(IntPtr.Zero, (IntPtr)32512);","                iconData.szTip = \u0022CouldBeAimmyV2\u0022;","                Shell_NotifyIcon(_trayIconCreated ? NIM_MODIFY : NIM_ADD, ref iconData);","                _trayIconCreated = true;","                if (!_eventsAttached)","                {","                    HwndSource source = HwndSource.FromHwnd(_mainApplicationHandle);","                    if (source != null)","                    {","                        source.AddHook(WndProc);","                        _eventsAttached = true;","                    }","                }","            }","            catch (Exception ex)","            {","                System.Diagnostics.Debug.WriteLine($\u0022Failed to add tray icon: {ex.Message}\u0022);","            }","        }"],"startLine":488}
{"method":{"methodHash":"5d6a72d12622b3fcdeb01586c1c4d4df","typeHash":"cd7f796341d141a5e5c575e726bb4c17","name":"DoUpdate","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/Other/UpdateManager.cs","bodySpan":{"startLine":71,"startColumn":9,"endLine":111,"endColumn":10},"calls":[{"span":{"startLine":74,"startColumn":34,"endLine":74,"endColumn":52},"calleeMethodHash":null,"calleeDisplayName":"GetTempPath"},{"span":{"startLine":75,"startColumn":35,"endLine":75,"endColumn":79},"calleeMethodHash":null,"calleeDisplayName":"Combine"},{"span":{"startLine":77,"startColumn":34,"endLine":77,"endColumn":114},"calleeMethodHash":null,"calleeDisplayName":"GetAsync"},{"span":{"startLine":79,"startColumn":38,"endLine":79,"endColumn":74},"calleeMethodHash":null,"calleeDisplayName":"ReadAsStreamAsync"},{"span":{"startLine":81,"startColumn":19,"endLine":81,"endColumn":49},"calleeMethodHash":null,"calleeDisplayName":"CopyToAsync"},{"span":{"startLine":84,"startColumn":34,"endLine":84,"endColumn":74},"calleeMethodHash":null,"calleeDisplayName":"Combine"},{"span":{"startLine":85,"startColumn":19,"endLine":88,"endColumn":15},"calleeMethodHash":null,"calleeDisplayName":"Run"},{"span":{"startLine":87,"startColumn":17,"endLine":87,"endColumn":76},"calleeMethodHash":null,"calleeDisplayName":"ExtractToDirectory"},{"span":{"startLine":93,"startColumn":34,"endLine":93,"endColumn":68},"calleeMethodHash":null,"calleeDisplayName":"GetDirectoryName"},{"span":{"startLine":95,"startColumn":38,"endLine":95,"endColumn":77},"calleeMethodHash":null,"calleeDisplayName":"Combine"},{"span":{"startLine":99,"startColumn":17,"endLine":99,"endColumn":42},"calleeMethodHash":null,"calleeDisplayName":"WriteLine"},{"span":{"startLine":100,"startColumn":17,"endLine":100,"endColumn":54},"calleeMethodHash":null,"calleeDisplayName":"WriteLine"},{"span":{"startLine":101,"startColumn":17,"endLine":101,"endColumn":80},"calleeMethodHash":null,"calleeDisplayName":"WriteLine"},{"span":{"startLine":102,"startColumn":17,"endLine":102,"endColumn":62},"calleeMethodHash":null,"calleeDisplayName":"WriteLine"},{"span":{"startLine":103,"startColumn":17,"endLine":103,"endColumn":59},"calleeMethodHash":null,"calleeDisplayName":"WriteLine"},{"span":{"startLine":104,"startColumn":17,"endLine":104,"endColumn":60},"calleeMethodHash":null,"calleeDisplayName":"WriteLine"},{"span":{"startLine":105,"startColumn":17,"endLine":105,"endColumn":62},"calleeMethodHash":null,"calleeDisplayName":"WriteLine"},{"span":{"startLine":106,"startColumn":17,"endLine":106,"endColumn":78},"calleeMethodHash":null,"calleeDisplayName":"WriteLine"},{"span":{"startLine":109,"startColumn":13,"endLine":109,"endColumn":43},"calleeMethodHash":null,"calleeDisplayName":"Start"},{"span":{"startLine":110,"startColumn":13,"endLine":110,"endColumn":32},"calleeMethodHash":null,"calleeDisplayName":"Exit"}]},"lines":["        private async Task DoUpdate(string latestZipUrl)","        {","            // Download the newest release of Aimmy to %temp%","            string envTempPath = Path.GetTempPath();","            string localZipPath = Path.Combine(envTempPath, \u0022AimmyUpdate.zip\u0022);","","            var response = await client.GetAsync(new Uri(latestZipUrl), HttpCompletionOption.ResponseHeadersRead);","","            using var stream = await response.Content.ReadAsStreamAsync();","            using var fileStream = new FileStream(localZipPath, FileMode.Create, FileAccess.Write, FileShare.None, 8192, true);","            await stream.CopyToAsync(fileStream);","","            // Extract update to %temp%","            string extractPath = Path.Combine(envTempPath, \u0022AimmyUpdate\u0022);","            await Task.Run(() =\u003E // Run extraction in a separate task","            {","                ZipFile.ExtractToDirectory(localZipPath, extractPath, true);","            });","","            // Create a batch script to move the files and restart Aimmy","            string? mainAppPath = Environment.ProcessPath;","","            string? mainAppDir = Path.GetDirectoryName(mainAppPath) ?? throw new InvalidOperationException(\u0022Failed to get the directory name from the main module file path.\u0022);","","            string batchScriptPath = Path.Combine(mainAppDir!, \u0022update.bat\u0022);","","            using (StreamWriter sw = new(batchScriptPath))","            {","                sw.WriteLine(\u0022@echo off\u0022);","                sw.WriteLine(\u0022timeout /t 3 /nobreak\u0022);","                sw.WriteLine($\u0022xcopy /Y \\\u0022{extractPath}\\\\*\\\u0022 \\\u0022{mainAppDir}\\\u0022\u0022);","                sw.WriteLine($\u0022start \\\u0022\\\u0022 \\\u0022{mainAppPath}\\\u0022\u0022);","                sw.WriteLine($\u0022del /f \\\u0022{localZipPath}\\\u0022\u0022);","                sw.WriteLine($\u0022rd /s /q \\\u0022{extractPath}\\\u0022\u0022);","                sw.WriteLine($\u0022del /f \\\u0022{batchScriptPath}\\\u0022\u0022);","                sw.WriteLine($\u0022( del /F /Q \\\u0022%~f0\\\u0022 \u003Enul 2\u003E\u00261 \u0026 exit ) \u003Enul\u0022);","            }","","            Process.Start(batchScriptPath);","            Environment.Exit(0);","        }"],"startLine":71}
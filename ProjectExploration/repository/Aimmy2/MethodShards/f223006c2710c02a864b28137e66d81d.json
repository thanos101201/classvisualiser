tion(wtfdetection);","                    var wtfpredictedPosition = wtfpredictionManager.GetEstimatedPosition();","","                    // Use both predicted X and Y","                    MouseManager.MoveCrosshair(wtfpredictedPosition.X, wtfpredictedPosition.Y);","                    break;","            }","        }"],"startLine":897}
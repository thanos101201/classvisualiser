           result.AverageFps \u003E= minimumUsefulFps \u0026\u0026","                    !HasHighLoad(result))","                .OrderBy(result =\u003E Math.Abs(result.ImageSize - midpoint))","                .ThenByDescending(result =\u003E result.AverageFps)","                .FirstOrDefault();","        }"],"startLine":308}
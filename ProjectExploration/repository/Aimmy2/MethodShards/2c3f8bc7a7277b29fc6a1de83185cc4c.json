{"method":{"methodHash":"2c3f8bc7a7277b29fc6a1de83185cc4c","typeHash":"2ef589c6a7dfe65b491ee9bf8fb54ca9","name":"ApplyToWindow","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/Other/StreamGuardManager.cs","bodySpan":{"startLine":151,"startColumn":9,"endLine":193,"endColumn":10},"calls":[{"span":{"startLine":160,"startColumn":59,"endLine":160,"endColumn":86},"calleeMethodHash":"2c3f8bc7a7277b29fc6a1de83185cc4c","calleeDisplayName":"Aimmy2.Other.StreamGuardManager.ApplyToWindow(Window, bool)"},{"span":{"startLine":167,"startColumn":21,"endLine":167,"endColumn":53},"calleeMethodHash":null,"calleeDisplayName":"Contains"},{"span":{"startLine":168,"startColumn":17,"endLine":168,"endColumn":44},"calleeMethodHash":null,"calleeDisplayName":"Add"},{"span":{"startLine":172,"startColumn":17,"endLine":172,"endColumn":47},"calleeMethodHash":null,"calleeDisplayName":"Remove"},{"span":{"startLine":175,"startColumn":13,"endLine":175,"endColumn":87},"calleeMethodHash":"3f73970a7e350b3cb52f572490e32c5e","calleeDisplayName":"Aimmy2.Other.StreamGuardManager.SetWindowDisplayAffinity(nint, uint)"},{"span":{"startLine":178,"startColumn":33,"endLine":178,"endColumn":65},"calleeMethodHash":"bbbdbfc16e106a24545e120c88c79457","calleeDisplayName":"Aimmy2.Other.StreamGuardManager.GetWindowLong(nint, int)"},{"span":{"startLine":180,"startColumn":17,"endLine":180,"endColumn":104},"calleeMethodHash":"bafb5d70d0458e86da9c733b2e00c4bb","calleeDisplayName":"Aimmy2.Other.StreamGuardManager.SetWindowLong(nint, int, int)"},{"span":{"startLine":182,"startColumn":17,"endLine":182,"endColumn":104},"calleeMethodHash":"bafb5d70d0458e86da9c733b2e00c4bb","calleeDisplayName":"Aimmy2.Other.StreamGuardManager.SetWindowLong(nint, int, int)"},{"span":{"startLine":187,"startColumn":17,"endLine":187,"endColumn":42},"calleeMethodHash":"4f02e4e63ce476e228d8a9bdc3352a4b","calleeDisplayName":"Aimmy2.Other.StreamGuardManager.AddTrayIcon(Window, nint)"},{"span":{"startLine":191,"startColumn":17,"endLine":191,"endColumn":37},"calleeMethodHash":"29310434edd315e0a4af761386882609","calleeDisplayName":"Aimmy2.Other.StreamGuardManager.RemoveTrayIcon(nint)"}]},"lines":["        private static void ApplyToWindow(Window window, bool enable)","        {","            if (window == null) return;","","            var hWnd = new WindowInteropHelper(window).Handle;","            if (hWnd == nint.Zero)","            {","                if (enable \u0026\u0026 _isEnabled)","                {","                    window.SourceInitialized \u002B= (s, e) =\u003E ApplyToWindow(window, true);","                }","                return;","            }","","            if (enable)","            {","                if (_protectedWindows.Contains(hWnd)) return;","                _protectedWindows.Add(hWnd);","            }","            else","            {","                _protectedWindows.Remove(hWnd);","            }","","            SetWindowDisplayAffinity(hWnd, enable ? WDA_EXCLUDEFROMCAPTURE : WDA_NONE);","            window.ShowInTaskbar = !enable;","","            var extendedStyle = GetWindowLong(hWnd, GWL_EXSTYLE);","            if (enable)","                SetWindowLong(hWnd, GWL_EXSTYLE, (extendedStyle | WS_EX_TOOLWINDOW) \u0026 ~WS_EX_APPWINDOW);","            else","                SetWindowLong(hWnd, GWL_EXSTYLE, (extendedStyle | WS_EX_APPWINDOW) \u0026 ~WS_EX_TOOLWINDOW);","","            // Manage tray icon (optional, for user feedback) - can be omitted if not needed - I love this vs feature.","            if (enable)","            {","                AddTrayIcon(window, hWnd);","            }","            else","            {","                RemoveTrayIcon(hWnd);","            }","        }"],"startLine":151}
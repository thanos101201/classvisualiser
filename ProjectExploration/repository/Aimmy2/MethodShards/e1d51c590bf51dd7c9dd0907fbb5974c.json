{"method":{"methodHash":"e1d51c590bf51dd7c9dd0907fbb5974c","typeHash":"e4a6a66cfe6c7304f91b9ce2765912cc","name":"ChooseHighSpeed","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/PerformanceBenchmark.cs","bodySpan":{"startLine":326,"startColumn":9,"endLine":354,"endColumn":10},"calls":[{"span":{"startLine":330,"startColumn":29,"endLine":330,"endColumn":88},"calleeMethodHash":null,"calleeDisplayName":"ToList"},{"span":{"startLine":330,"startColumn":29,"endLine":330,"endColumn":79},"calleeMethodHash":null,"calleeDisplayName":"Where"},{"span":{"startLine":330,"startColumn":59,"endLine":330,"endColumn":78},"calleeMethodHash":"d3ccd3079fe13cb62c2ffb28a5e403ab","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.HasHighLoad(Aimmy2.AILogic.PerformanceBenchmarkSizeResult)"},{"span":{"startLine":331,"startColumn":60,"endLine":331,"endColumn":81},"calleeMethodHash":null,"calleeDisplayName":"ToList"},{"span":{"startLine":333,"startColumn":28,"endLine":335,"endColumn":26},"calleeMethodHash":null,"calleeDisplayName":"ToList"},{"span":{"startLine":333,"startColumn":28,"endLine":334,"endColumn":110},"calleeMethodHash":null,"calleeDisplayName":"Where"},{"span":{"startLine":339,"startColumn":24,"endLine":342,"endColumn":29},"calleeMethodHash":null,"calleeDisplayName":"First"},{"span":{"startLine":339,"startColumn":24,"endLine":341,"endColumn":67},"calleeMethodHash":null,"calleeDisplayName":"ThenByDescending"},{"span":{"startLine":339,"startColumn":24,"endLine":340,"endColumn":57},"calleeMethodHash":null,"calleeDisplayName":"OrderBy"},{"span":{"startLine":345,"startColumn":20,"endLine":349,"endColumn":34},"calleeMethodHash":null,"calleeDisplayName":"FirstOrDefault"},{"span":{"startLine":345,"startColumn":20,"endLine":348,"endColumn":63},"calleeMethodHash":null,"calleeDisplayName":"ThenByDescending"},{"span":{"startLine":345,"startColumn":20,"endLine":347,"endColumn":53},"calleeMethodHash":null,"calleeDisplayName":"OrderBy"},{"span":{"startLine":345,"startColumn":20,"endLine":346,"endColumn":113},"calleeMethodHash":null,"calleeDisplayName":"Where"},{"span":{"startLine":350,"startColumn":17,"endLine":353,"endColumn":29},"calleeMethodHash":null,"calleeDisplayName":"First"},{"span":{"startLine":350,"startColumn":17,"endLine":352,"endColumn":56},"calleeMethodHash":null,"calleeDisplayName":"ThenBy"},{"span":{"startLine":350,"startColumn":17,"endLine":351,"endColumn":68},"calleeMethodHash":null,"calleeDisplayName":"OrderByDescending"}]},"lines":["        private static PerformanceBenchmarkSizeResult ChooseHighSpeed(","            IReadOnlyList\u003CPerformanceBenchmarkSizeResult\u003E validResults,","            PerformanceBenchmarkSizeResult bestThroughput)","        {","            var preferred = validResults.Where(result =\u003E !HasHighLoad(result)).ToList();","            var source = preferred.Count \u003E 0 ? preferred : validResults.ToList();","","            var playable = source","                .Where(result =\u003E result.AverageFps \u003E= HighSpeedPlayableFps \u0026\u0026 result.SuggestedFpsLimit \u003E= 30)","                .ToList();","","            if (playable.Count \u003E 0)","            {","                return playable","                    .OrderBy(result =\u003E result.ImageSize)","                    .ThenByDescending(result =\u003E result.AverageFps)","                    .First();","            }","","            return source","                .Where(result =\u003E result.AverageFps \u003E= bestThroughput.AverageFps * MinimumRelativeFpsForTradeoff)","                .OrderBy(result =\u003E result.ImageSize)","                .ThenByDescending(result =\u003E result.AverageFps)","                .FirstOrDefault() ??","                source","                    .OrderByDescending(result =\u003E result.AverageFps)","                    .ThenBy(result =\u003E result.ImageSize)","                    .First();","        }"],"startLine":326}
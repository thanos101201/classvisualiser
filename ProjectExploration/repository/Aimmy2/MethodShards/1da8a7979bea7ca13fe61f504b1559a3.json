{"method":{"methodHash":"1da8a7979bea7ca13fe61f504b1559a3","typeHash":"680270b987e77cf65d4553f3fb30ce2d","name":"CreateContributorChip","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/UISections/AboutMenuControl.xaml.cs","bodySpan":{"startLine":219,"startColumn":9,"endLine":264,"endColumn":10},"calls":[{"span":{"startLine":225,"startColumn":43,"endLine":225,"endColumn":81},"calleeMethodHash":null,"calleeDisplayName":"FromArgb"},{"span":{"startLine":238,"startColumn":43,"endLine":238,"endColumn":81},"calleeMethodHash":null,"calleeDisplayName":"FromArgb"},{"span":{"startLine":244,"startColumn":18,"endLine":244,"endColumn":46},"calleeMethodHash":null,"calleeDisplayName":"IsNullOrEmpty"},{"span":{"startLine":251,"startColumn":47,"endLine":251,"endColumn":85},"calleeMethodHash":null,"calleeDisplayName":"FromArgb"},{"span":{"startLine":252,"startColumn":47,"endLine":252,"endColumn":85},"calleeMethodHash":null,"calleeDisplayName":"FromArgb"},{"span":{"startLine":258,"startColumn":47,"endLine":258,"endColumn":85},"calleeMethodHash":null,"calleeDisplayName":"FromArgb"},{"span":{"startLine":260,"startColumn":55,"endLine":260,"endColumn":80},"calleeMethodHash":"9f8009efddd35d0cc159723544a9f181","calleeDisplayName":"Aimmy2.Controls.AboutMenuControl.OpenGitHubProfile(string)"}]},"lines":["        private Border CreateContributorChip(string name, string? github, bool highlighted)","        {","            var border = new Border","            {","                Background = highlighted","                    ? _themeColor","                    : new SolidColorBrush(Color.FromArgb(0x15, 0xFF, 0xFF, 0xFF)),","                CornerRadius = new CornerRadius(highlighted ? 12 : 10),","                Padding = new Thickness(highlighted ? 12 : 10, highlighted ? 6 : 5, highlighted ? 12 : 10, highlighted ? 6 : 5),","                Margin = new Thickness(highlighted ? 4 : 3)","            };","","            var text = new TextBlock","            {","                Text = name,","                FontFamily = _fontFamily,","                FontSize = highlighted ? 11 : 10,","                Foreground = highlighted","                    ? Brushes.White","                    : new SolidColorBrush(Color.FromArgb(0xAA, 0xFF, 0xFF, 0xFF))","            };","","            border.Child = text;","","            // Make clickable if has GitHub","            if (!string.IsNullOrEmpty(github))","            {","                var themeColor = _themeColor; // Capture for lambda","                border.Cursor = Cursors.Hand;","                border.MouseEnter \u002B= (s, e) =\u003E","                {","                    border.Background = highlighted","                        ? new SolidColorBrush(Color.FromArgb(0xFF, 0x90, 0x60, 0xE0))","                        : new SolidColorBrush(Color.FromArgb(0x25, 0xFF, 0xFF, 0xFF));","                };","                border.MouseLeave \u002B= (s, e) =\u003E","                {","                    border.Background = highlighted","                        ? themeColor","                        : new SolidColorBrush(Color.FromArgb(0x15, 0xFF, 0xFF, 0xFF));","                };","                border.MouseLeftButtonUp \u002B= (s, e) =\u003E OpenGitHubProfile(github);","            }","","            return border;","        }"],"startLine":219}
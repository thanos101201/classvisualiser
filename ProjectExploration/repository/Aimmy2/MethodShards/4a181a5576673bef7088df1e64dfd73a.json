{"method":{"methodHash":"4a181a5576673bef7088df1e64dfd73a","typeHash":"e26486f9fb3b532a75fbd7f41699ff2f","name":"ApplyFpsLimitAsync","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/AIManager.cs","bodySpan":{"startLine":601,"startColumn":9,"endLine":613,"endColumn":10},"calls":[{"span":{"startLine":611,"startColumn":23,"endLine":611,"endColumn":92},"calleeMethodHash":null,"calleeDisplayName":"Delay"},{"span":{"startLine":611,"startColumn":39,"endLine":611,"endColumn":72},"calleeMethodHash":null,"calleeDisplayName":"Floor"}]},"lines":["        private static async Task ApplyFpsLimitAsync(Stopwatch iterationStopwatch, CancellationToken cancellationToken)","        {","            int fpsLimit = AimSettings.AiFpsLimit;","            if (fpsLimit \u003C= 0)","                return;","","            double targetMilliseconds = 1000.0 / fpsLimit;","            double remainingMilliseconds = targetMilliseconds - iterationStopwatch.Elapsed.TotalMilliseconds;","            if (remainingMilliseconds \u003E 1)","            {","                await Task.Delay((int)Math.Floor(remainingMilliseconds), cancellationToken);","            }","        }"],"startLine":601}
       FindThemedChildren(element, elementInfoList);","","            if (elementInfoList.Count \u003E 0)","            {","                _themedElements[weakRef] = elementInfoList;","","                // Apply theme immediately","                ApplyThemeToElement(element, elementInfoList);","            }","","            // If this is the MainWindow, update gradients and resources","            if (element == Application.Current?.MainWindow)","            {","                UpdateDynamicResources();","                UpdateMainWindowGradients();","            }","        }"],"startLine":524}
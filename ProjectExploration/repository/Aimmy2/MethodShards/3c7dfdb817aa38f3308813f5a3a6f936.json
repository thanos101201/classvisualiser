{"method":{"methodHash":"3c7dfdb817aa38f3308813f5a3a6f936","typeHash":"680270b987e77cf65d4553f3fb30ce2d","name":"LoadGitHubAvatar","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/UISections/AboutMenuControl.xaml.cs","bodySpan":{"startLine":155,"startColumn":9,"endLine":201,"endColumn":10},"calls":[{"span":{"startLine":160,"startColumn":38,"endLine":160,"endColumn":68},"calleeMethodHash":null,"calleeDisplayName":"GetAsync"},{"span":{"startLine":164,"startColumn":43,"endLine":164,"endColumn":82},"calleeMethodHash":null,"calleeDisplayName":"ReadAsByteArrayAsync"},{"span":{"startLine":166,"startColumn":27,"endLine":194,"endColumn":23},"calleeMethodHash":null,"calleeDisplayName":"InvokeAsync"},{"span":{"startLine":171,"startColumn":29,"endLine":171,"endColumn":47},"calleeMethodHash":null,"calleeDisplayName":"BeginInit"},{"span":{"startLine":174,"startColumn":29,"endLine":174,"endColumn":45},"calleeMethodHash":null,"calleeDisplayName":"EndInit"},{"span":{"startLine":175,"startColumn":29,"endLine":175,"endColumn":44},"calleeMethodHash":null,"calleeDisplayName":"Freeze"}]},"lines":["        private async void LoadGitHubAvatar(string username, Border avatarBorder, TextBlock fallbackText)","        {","            try","            {","                var imageUrl = $\u0022https://github.com/{username}.png?size=96\u0022;","                var response = await _httpClient.GetAsync(imageUrl);","","                if (response.IsSuccessStatusCode)","                {","                    var imageData = await response.Content.ReadAsByteArrayAsync();","","                    await Dispatcher.InvokeAsync(() =\u003E","                    {","                        try","                        {","                            var bitmap = new BitmapImage();","                            bitmap.BeginInit();","                            bitmap.StreamSource = new System.IO.MemoryStream(imageData);","                            bitmap.CacheOption = BitmapCacheOption.OnLoad;","                            bitmap.EndInit();","                            bitmap.Freeze();","","                            var image = new Ellipse","                            {","                                Width = 48,","                                Height = 48,","                                Fill = new ImageBrush(bitmap)","                                {","                                    Stretch = Stretch.UniformToFill","                                }","                            };","","                            avatarBorder.Background = Brushes.Transparent;","                            avatarBorder.Child = image;","                        }","                        catch","                        {","                            // Keep fallback text on error","                        }","                    });","                }","            }","            catch","            {","                // Keep fallback text on error","            }","        }"],"startLine":155}
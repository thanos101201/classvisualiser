{"method":{"methodHash":"1c8b16d7a6c871585181cf8d139f66c4","typeHash":"e4a6a66cfe6c7304f91b9ce2765912cc","name":"ChooseBalanced","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/PerformanceBenchmark.cs","bodySpan":{"startLine":254,"startColumn":9,"endLine":306,"endColumn":10},"calls":[{"span":{"startLine":263,"startColumn":17,"endLine":263,"endColumn":37},"calleeMethodHash":"d3ccd3079fe13cb62c2ffb28a5e403ab","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.HasHighLoad(Aimmy2.AILogic.PerformanceBenchmarkSizeResult)"},{"span":{"startLine":265,"startColumn":33,"endLine":272,"endColumn":38},"calleeMethodHash":null,"calleeDisplayName":"FirstOrDefault"},{"span":{"startLine":265,"startColumn":33,"endLine":271,"endColumn":67},"calleeMethodHash":null,"calleeDisplayName":"OrderByDescending"},{"span":{"startLine":265,"startColumn":33,"endLine":270,"endColumn":46},"calleeMethodHash":null,"calleeDisplayName":"Where"},{"span":{"startLine":270,"startColumn":26,"endLine":270,"endColumn":45},"calleeMethodHash":"d3ccd3079fe13cb62c2ffb28a5e403ab","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.HasHighLoad(Aimmy2.AILogic.PerformanceBenchmarkSizeResult)"},{"span":{"startLine":279,"startColumn":35,"endLine":282,"endColumn":72},"calleeMethodHash":null,"calleeDisplayName":"OrderByDescending"},{"span":{"startLine":279,"startColumn":35,"endLine":281,"endColumn":107},"calleeMethodHash":null,"calleeDisplayName":"Where"},{"span":{"startLine":279,"startColumn":35,"endLine":280,"endColumn":80},"calleeMethodHash":null,"calleeDisplayName":"Where"},{"span":{"startLine":286,"startColumn":21,"endLine":286,"endColumn":39},"calleeMethodHash":"d3ccd3079fe13cb62c2ffb28a5e403ab","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.HasHighLoad(Aimmy2.AILogic.PerformanceBenchmarkSizeResult)"},{"span":{"startLine":291,"startColumn":21,"endLine":291,"endColumn":64},"calleeMethodHash":"06415c5b1d27dadc5594bae90dc93d27","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.HasMeaningfulEfficiencyGain(Aimmy2.AILogic.PerformanceBenchmarkSizeResult, Aimmy2.AILogic.PerformanceBenchmarkSizeResult)"},{"span":{"startLine":298,"startColumn":17,"endLine":298,"endColumn":64},"calleeMethodHash":"06415c5b1d27dadc5594bae90dc93d27","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.HasMeaningfulEfficiencyGain(Aimmy2.AILogic.PerformanceBenchmarkSizeResult, Aimmy2.AILogic.PerformanceBenchmarkSizeResult)"},{"span":{"startLine":300,"startColumn":30,"endLine":300,"endColumn":102},"calleeMethodHash":"bc28fd5f2179303ef18c1e0fe26e1f46","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.ChooseMiddleFallback(System.Collections.Generic.IReadOnlyList\u003CAimmy2.AILogic.PerformanceBenchmarkSizeResult\u003E, Aimmy2.AILogic.PerformanceBenchmarkSizeResult, Aimmy2.AILogic.PerformanceBenchmarkSizeResult, double)"}]},"lines":["        private static PerformanceBenchmarkSizeResult ChooseBalanced(","            IReadOnlyList\u003CPerformanceBenchmarkSizeResult\u003E validResults,","            PerformanceBenchmarkSizeResult bestThroughput,","            PerformanceBenchmarkSizeResult quality,","            PerformanceBenchmarkSizeResult highSpeed)","        {","            double minimumUsefulFps = bestThroughput.AverageFps * MinimumRelativeFpsForTradeoff;","            bool hasDistinctHighSpeed = highSpeed.ImageSize \u003C quality.ImageSize;","","            if (HasHighLoad(quality))","            {","                var lowerLoad = validResults","                    .Where(result =\u003E","                        result.ImageSize \u003C quality.ImageSize \u0026\u0026","                        (!hasDistinctHighSpeed || result.ImageSize \u003E highSpeed.ImageSize) \u0026\u0026","                        result.AverageFps \u003E= minimumUsefulFps \u0026\u0026","                        !HasHighLoad(result))","                    .OrderByDescending(result =\u003E result.ImageSize)","                    .FirstOrDefault();","","                if (lowerLoad != null)","                    return lowerLoad;","            }","","            double minimumEfficiencyFps = quality.AverageFps * MinimumRelativeFpsForBalancedEfficiency;","            foreach (var lower in validResults","                         .Where(result =\u003E result.ImageSize \u003C quality.ImageSize)","                         .Where(result =\u003E !hasDistinctHighSpeed || result.ImageSize \u003E highSpeed.ImageSize)","                         .OrderByDescending(result =\u003E result.ImageSize))","            {","                if (lower.AverageFps \u003C minimumUsefulFps ||","                    lower.AverageFps \u003C minimumEfficiencyFps ||","                    HasHighLoad(lower))","                {","                    continue;","                }","","                if (HasMeaningfulEfficiencyGain(quality, lower))","                    return lower;","            }","","            if (hasDistinctHighSpeed \u0026\u0026","                highSpeed.AverageFps \u003E= minimumUsefulFps \u0026\u0026","                highSpeed.AverageFps \u003E= minimumEfficiencyFps \u0026\u0026","                HasMeaningfulEfficiencyGain(quality, highSpeed))","            {","                var middle = ChooseMiddleFallback(validResults, quality, highSpeed, minimumUsefulFps);","                if (middle != null)","                    return middle;","            }","","            return quality;","        }"],"startLine":254}
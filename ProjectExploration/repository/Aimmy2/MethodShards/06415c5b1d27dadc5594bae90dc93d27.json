{"method":{"methodHash":"06415c5b1d27dadc5594bae90dc93d27","typeHash":"e4a6a66cfe6c7304f91b9ce2765912cc","name":"HasMeaningfulEfficiencyGain","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/PerformanceBenchmark.cs","bodySpan":{"startLine":391,"startColumn":9,"endLine":407,"endColumn":10},"calls":[{"span":{"startLine":403,"startColumn":28,"endLine":403,"endColumn":105},"calleeMethodHash":"0125554745acbe9e6c3f8a34924128c7","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.HasMeaningfulLoadDrop(double, double)"},{"span":{"startLine":404,"startColumn":28,"endLine":404,"endColumn":105},"calleeMethodHash":"0125554745acbe9e6c3f8a34924128c7","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.HasMeaningfulLoadDrop(double, double)"}]},"lines":["        private static bool HasMeaningfulEfficiencyGain(","            PerformanceBenchmarkSizeResult quality,","            PerformanceBenchmarkSizeResult candidate)","        {","            bool fpsClose = candidate.AverageFps \u003E= quality.AverageFps * MinimumRelativeFpsForBalancedEfficiency ||","                            candidate.SuggestedFpsLimit \u003E= quality.SuggestedFpsLimit - 15;","","            if (!fpsClose)","                return false;","","            bool gpuDrop = quality.GpuAvailable \u0026\u0026","                           candidate.GpuAvailable \u0026\u0026","                           HasMeaningfulLoadDrop(quality.AverageGpuPercent, candidate.AverageGpuPercent);","            bool cpuDrop = HasMeaningfulLoadDrop(quality.AverageCpuPercent, candidate.AverageCpuPercent);","","            return gpuDrop || cpuDrop;","        }"],"startLine":391}
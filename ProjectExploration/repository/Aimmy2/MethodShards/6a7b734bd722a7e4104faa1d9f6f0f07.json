G * 0.3), (byte)(c.B * 0.3)),","                    [\u0022HighlighterGradient1\u0022] = c =\u003E c,","                    [\u0022HighlighterGradient2\u0022] = c =\u003E Color.FromArgb(102, c.R, c.G, c.B)","                };","","                foreach (var (elementName, colorTransform) in gradientMappings)","                {","                    if (FindName(elementName) is GradientStop gradientStop)","                    {","                        gradientStop.Color = colorTransform(color);","                    }","                }","            }","            catch (Exception ex)","            {","            }","        }"],"startLine":324}
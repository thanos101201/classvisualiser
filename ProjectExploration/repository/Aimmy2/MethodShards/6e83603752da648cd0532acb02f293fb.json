{"method":{"methodHash":"6e83603752da648cd0532acb02f293fb","typeHash":"76fd280d7e01de4545983d9bd02a73bf","name":"CheckForGhub","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/Other/RequirementsManager.cs","bodySpan":{"startLine":41,"startColumn":9,"endLine":74,"endColumn":10},"calls":[{"span":{"startLine":45,"startColumn":36,"endLine":45,"endColumn":88},"calleeMethodHash":null,"calleeDisplayName":"FirstOrDefault"},{"span":{"startLine":45,"startColumn":36,"endLine":45,"endColumn":71},"calleeMethodHash":null,"calleeDisplayName":"GetProcessesByName"},{"span":{"startLine":48,"startColumn":21,"endLine":48,"endColumn":49},"calleeMethodHash":"a7ff5e13d97d136e87cc265c31e7f978","calleeDisplayName":"Other.RequirementsManager.ShowLGHubNotRunningMessage()"},{"span":{"startLine":55,"startColumn":21,"endLine":55,"endColumn":118},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"},{"span":{"startLine":59,"startColumn":47,"endLine":59,"endColumn":91},"calleeMethodHash":null,"calleeDisplayName":"GetVersionInfo"},{"span":{"startLine":61,"startColumn":22,"endLine":61,"endColumn":65},"calleeMethodHash":null,"calleeDisplayName":"Contains"},{"span":{"startLine":63,"startColumn":21,"endLine":63,"endColumn":54},"calleeMethodHash":"864c4f7f4aad997440f92aaa8bd394e3","calleeDisplayName":"Other.RequirementsManager.ShowLGHubImproperInstallMessage()"},{"span":{"startLine":71,"startColumn":17,"endLine":71,"endColumn":128},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"}]},"lines":["        public static bool CheckForGhub()","        {","            try","            {","                Process? process = Process.GetProcessesByName(\u0022lghub\u0022).FirstOrDefault(); //gets the first process named \u0022lghub\u0022","                if (process == null)","                {","                    ShowLGHubNotRunningMessage();","                    return false;","                }","","                string ghubfilepath = process.MainModule.FileName;","                if (ghubfilepath == null)","                {","                    LogManager.Log(LogManager.LogLevel.Error, \u0022An error occurred. Run as admin and try again.\u0022, true);","                    return false;","                }","","                FileVersionInfo versionInfo = FileVersionInfo.GetVersionInfo(ghubfilepath);","","                if (!versionInfo.ProductVersion.Contains(\u00222021\u0022))","                {","                    ShowLGHubImproperInstallMessage();","                    return false;","                }","","                return true;","            }","            catch (AccessViolationException ex)","            {","                LogManager.Log(LogManager.LogLevel.Error, $\u0022An error occured: {ex.Message}\\nRun as admin and try again.\u0022, true);","                return false;","            }","        }"],"startLine":41}
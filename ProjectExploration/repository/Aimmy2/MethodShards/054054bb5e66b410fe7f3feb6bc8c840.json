{"method":{"methodHash":"054054bb5e66b410fe7f3feb6bc8c840","typeHash":"e212d1e8cf791118b97599dbc2bd3f34","name":"PositionSelectorForColor","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/UILibrary/AColorWheel.xaml.cs","bodySpan":{"startLine":294,"startColumn":9,"endLine":330,"endColumn":10},"calls":[{"span":{"startLine":300,"startColumn":13,"endLine":300,"endColumn":49},"calleeMethodHash":"dd0be635892446875fcc6605f98a0c1b","calleeDisplayName":"Aimmy2.UILibrary.AColorWheel.RgbToHsv(Color, out double, out double, out double)"},{"span":{"startLine":311,"startColumn":53,"endLine":311,"endColumn":68},"calleeMethodHash":null,"calleeDisplayName":"Cos"},{"span":{"startLine":312,"startColumn":54,"endLine":312,"endColumn":69},"calleeMethodHash":null,"calleeDisplayName":"Sin"},{"span":{"startLine":314,"startColumn":13,"endLine":314,"endColumn":50},"calleeMethodHash":null,"calleeDisplayName":"SetLeft"},{"span":{"startLine":315,"startColumn":13,"endLine":315,"endColumn":49},"calleeMethodHash":null,"calleeDisplayName":"SetTop"},{"span":{"startLine":327,"startColumn":13,"endLine":327,"endColumn":39},"calleeMethodHash":"53f5a5fbaec07ac36d0033254c0441d2","calleeDisplayName":"Aimmy2.UILibrary.AColorWheel.UpdateBrightnessGradient()"}]},"lines":["        private void PositionSelectorForColor(Color color)","        {","            _isUpdatingFromCode = true;","","            // Convert RGB to HSV to find position","            double h, s, v;","            RgbToHsv(color, out h, out s, out v);","","            // Store current values","            _currentHue = h;","            _currentSaturation = s;","            _brightness = v;","","            // Calculate position from HSV","            double angle = h * Math.PI / 180.0 - Math.PI;","            double radius = s * (ColorWheelCanvas.Width / 2);","","            double x = ColorWheelCanvas.Width / 2 \u002B Math.Cos(angle) * radius;","            double y = ColorWheelCanvas.Height / 2 \u002B Math.Sin(angle) * radius;","","            Canvas.SetLeft(ColorSelector, x - 10);","            Canvas.SetTop(ColorSelector, y - 10);","","            // Set brightness slider","            BrightnessSlider.Value = v;","","            // Update selector dot color","            if (ColorDot != null)","            {","                ColorDot.Fill = new SolidColorBrush(color);","            }","","            // Update brightness gradient","            UpdateBrightnessGradient();","","            _isUpdatingFromCode = false;","        }"],"startLine":294}
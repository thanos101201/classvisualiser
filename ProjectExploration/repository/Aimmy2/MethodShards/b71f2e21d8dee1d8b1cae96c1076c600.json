eeDisplayName":"Run"},{"span":{"startLine":991,"startColumn":36,"endLine":991,"endColumn":64},"calleeMethodHash":null,"calleeDisplayName":"AsTensor\u003Cfloat\u003E"},{"span":{"startLine":996,"startColumn":21,"endLine":996,"endColumn":100},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"},{"span":{"startLine":997,"startColumn":21,"endLine":997,"endColumn":37},"calleeMethodHash":"7a15226972f756826cf689efae27aa73","calleeDisplayName":"Aimmy2.AILogic.AIManager.SaveFrame(Bitmap, Aimmy2.AILogic.Prediction?)"},{"span":{"startLine":1010,"startColumn":24,"endLine":1010,"endColumn":54},"calleeMethodHash":"c466cbc379b362aac1ab3a40b716ed58","calleeDisplayName":"Aimmy2.AILogic.AIManager.Benchmark(string)"},{"span":{"startLine":1015,"startColumn":37,"endLine":1027,"endColumn":33},"calleeMethodHash":"5e36eaf5ca69ce4e29968eadbeb53bb3","calleeDisplayName":"Aimmy2.AILogic.PredictionFilter.CreatePredictions(Microsoft.ML.OnnxRuntime.Tensors.Tensor\u003Cfloat\u003E, System.Drawing.Rectangle, int, int, int, System.Collections.Generic.IReadOnlyDictionary\u003Cint, string\u003E, float, string, float, float, float, float)"},{"span":{"startLine":1032,"startColumn":21,"endLine":1032,"endColumn":37},"calleeMethodHash":"7a15226972f756826cf689efae27aa73","calleeDisplayName":"Aimmy2.AILogic.AIManager.SaveFrame(Bitmap, Aimmy2.AILogic.Prediction?)"},{"span":{"startLine":1044,"startColumn":24,"endLine":1044,"endColumn":49},"calleeMethodHash":"c466cbc379b362aac1ab3a40b716ed58","calleeDisplayName":"Aimmy2.AILogic.AIManager.Benchmark(string)"},{"span":{"startLine":1061,"startColumn":43,"endLine":1066,"endColumn":35},"calleeMethodHash":"94fceace05930122fa5b60ddecfdfebf","calleeDisplayName":"Aimmy2.AILogic.StickyAimSelector.SelectTarget(bool, float, int, Aimmy2.AILogic.Prediction?, System.Collections.Generic.IReadOnlyList\u003CAimmy2.AILogic.Prediction\u003E)"},{"span":{"startLine":1069,"startColumn":21,"endLine":1069,"endColumn":66},"calleeMethodHash":"fff690e3ff97b3bb94e4fd11dea0ac22","calleeDisplayName":"Aimmy2.AILogic.AIManager.UpdateDetectionBox(Aimmy2.AILogic.Prediction, System.Drawing.Rectangle)"},{"span":{"startLine":1070,"startColumn":21,"endLine":1070,"endColumn":50},"calleeMethodHash":"7a15226972f756826cf689efae27aa73","calleeDisplayName":"Aimmy2.AILogic.AIManager.SaveFrame(Bitmap, Aimmy2.AILogic.Prediction?)"},{"span":{"startLine":1079,"startColumn":17,"endLine":1079,"endColumn":32},"calleeMethodHash":null,"calleeDisplayName":"Dispose"},{"span":{"startLine":1080,"startColumn":25,"endLine":1080,"endColumn":35},"calleeMethodHash":null,"calleeDisplayName":".Dispose"}]},"lines":["        private async Task\u003CPrediction?\u003E GetClosestPrediction(bool useMousePosition = true)","        {","            _lastPredictionRanInference = false;","            Rectangle detectionBox = CreateDetectionBox(useMousePosition);","","            Bitmap? frame;","","            using (Benchmark(\u0022ScreenGrab\u0022))","            {","                frame = _captureManager.ScreenGrab(detectionBox, allowStaleCache: _benchmarkMode);","            }","","            if (frame == null) return null;","","            IDisposableReadOnlyCollection\u003CDisposableNamedOnnxValue\u003E? results = null;","            Tensor\u003Cfloat\u003E? outputTensor = null;","","            try","            {","                float[] inputArray;","                using (Benchmark(\u0022BitmapToFloatArray\u0022))","                {","                    if (_reusableInputArray == null || _reusableInputArray.Length != 3 * IMAGE_SIZE * IMAGE_SIZE)","                    {","                        _reusableInputArray = new float[3 * IMAGE_SIZE * IMAGE_SIZE];","                    }","                    inputArray = _reusableInputArray;","","                    // Fill the reusable array","                    BitmapToFloatArrayInPlace(frame, inputArray, IMAGE_SIZE);","                }","","                // Reuse tensor and inputs - recreate if size changed","                /// this needs to be revised !!!!! - taylor","                if (_reusableTensor == null || _reusableTensor.Dimensions[2] != IMAGE_SIZE)","                {","                    _reusableTensor = new DenseTensor\u003Cfloat\u003E(inputArray, new int[] { 1, 3, IMAGE_SIZE, IMAGE_SIZE });","                    _reusableInputs = new List\u003CNamedOnnxValue\u003E { NamedOnnxValue.CreateFromTensor(\u0022images\u0022, _reusableTensor) };","                }","                else","                {","                    // Directly copy into existing DenseTensor buffer","                    inputArray.AsSpan().CopyTo(_reusableTensor.Buffer.Span);","                }","","                if (_onnxModel == null) return null;","                using (Benchmark(\u0022ModelInference\u0022))","                {","                    results = _onnxModel.Run(_reusableInputs, _outputNames, _modeloptions);","                    _lastPredictionRanInference = true;","                    outputTensor = results[0].AsTensor\u003Cfloat\u003E();","                }","","                if (outputTensor == null)","                {","                    Log(LogLevel.Error, \u0022Model inference returned null output tensor.\u0022, true, 2000);","                    SaveFrame(frame);","                    return null;","                }","","                // Calculate the FOV boundaries","                float FovSize = (float)AimSettings.FovSize;","                float fovMinX = (IMAGE_SIZE - FovSize) / 2.0f;","                float fovMaxX = (IMAGE_SIZE \u002B FovSize) / 2.0f;","                float fovMinY = (IMAGE_SIZE - FovSize) / 2.0f;","                float fovMaxY = (IMAGE_SIZE \u002B FovSize) / 2.0f;","","                //List\u003Cdouble[]\u003E KDpoints;","                List\u003CPrediction\u003E KDPredictions;","                using (Benchmark(\u0022PrepareKDTreeData\u0022))","                {","                    float minConfidence = AimSettings.MinimumConfidence;","                    string selectedClass = AimSettings.TargetClass;","","                    KDPredictions = PredictionFilter.CreatePredictions(","                        outputTensor,","                        detectionBox,","                        IMAGE_SIZE,","                        NUM_DETECTIONS,","                        NUM_CLASSES,","                        _modelClasses,","                        minConfidence,","                        selectedClass,","                        fovMinX,","                        fovMaxX,","                        fovMinY,","                        fovMaxY);","                }","","                if (KDPredictions.Count == 0)","                {","                    SaveFrame(frame);","                    return null;","                }","","                //kdtree was replaced with linear search","                Prediction? bestCandidate = null;","                double bestDistSq = double.MaxValue;","                double center = IMAGE_SIZE / 2.0;","","                // TODO: Optimize this linear search further if needed","                // TODO: Consider updating KD-Tree and adding options to switch from linear to kd.","                // we can honestly replacing linear search by letting sticky aim handle the search","                using (Benchmark(\u0022LinearSearch\u0022))","                {","                    foreach (var p in KDPredictions)","                    {","                        var dx = p.CenterXTranslated * IMAGE_SIZE - center;","                        var dy = p.CenterYTranslated * IMAGE_SIZE - center;","                        double d2 = dx * dx \u002B dy * dy; // dx^2 \u002B dy^2","","                        if (d2 \u003C bestDistSq) { bestDistSq = d2; bestCandidate = p; }","                    }","                }","","                if (_benchmarkMode)","                {","                    return bestCandidate;","                }","","                Prediction? finalTarget = _stickyAimSelector.SelectTarget(","                    AimSettings.StickyAim,","                    (float)AimSettings.StickyAimThreshold,","                    IMAGE_SIZE,","                    bestCandidate,","                    KDPredictions);","                if (finalTarget != null)","                {","                    UpdateDetectionBox(finalTarget, detectionBox);","                    SaveFrame(frame, finalTarget);","                    return finalTarget;","                }","","                return null;","            }","            finally","            {","                // Always dispose the cloned frame to prevent memory leaks","                frame.Dispose();","                results?.Dispose();","            }","        }"],"startLine":941}
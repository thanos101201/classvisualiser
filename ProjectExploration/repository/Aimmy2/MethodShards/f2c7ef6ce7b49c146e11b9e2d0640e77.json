"            {","                using HttpClient client = new();","                var response = await client.GetAsync(\u0022https://rzr.to/synapse-new-pc-download-beta\u0022);","                if (!response.IsSuccessStatusCode)","                {","                    new NoticeBar(\u0022Failed to download Razer Synapse installer.\u0022, 4000).Show();","                    return;","                }","","                string path = Path.Combine(Path.GetTempPath(), \u0022rz.exe\u0022);","                var content = await response.Content.ReadAsByteArrayAsync();","                await File.WriteAllBytesAsync(path, content);","","                Process.Start(new ProcessStartInfo","                {","                    WindowStyle = ProcessWindowStyle.Hidden,","                    FileName = \u0022cmd.exe\u0022,","                    Arguments = \u0022/C start rz.exe\u0022,","                    WorkingDirectory = Path.GetTempPath()","                });","","                new NoticeBar(\u0022Razer Synapse downloaded. Please confirm the UAC prompt to install.\u0022, 4000).Show();","            }","            catch","            {","                new NoticeBar(\u0022Error occurred while downloading Synapse.\u0022, 4000).Show();","            }","        }"],"startLine":140}
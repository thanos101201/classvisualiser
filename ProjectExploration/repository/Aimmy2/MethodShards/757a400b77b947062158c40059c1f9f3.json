{"method":{"methodHash":"757a400b77b947062158c40059c1f9f3","typeHash":"e54f21c2b7b67a13241dc332527b9d00","name":"CreateSelectionRecommendation","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/Visuality/PerformanceHelperWindow.xaml.cs","bodySpan":{"startLine":905,"startColumn":9,"endLine":934,"endColumn":10},"calls":[{"span":{"startLine":909,"startColumn":39,"endLine":909,"endColumn":80},"calleeMethodHash":"4a6424f833dfc90277bfe66b0b4c326c","calleeDisplayName":"Visuality.PerformanceHelperWindow.GetMatchingRecommendation(Aimmy2.AILogic.PerformanceBenchmarkSizeResult, Aimmy2.AILogic.PerformanceBenchmarkReport)"},{"span":{"startLine":929,"startColumn":17,"endLine":929,"endColumn":82},"calleeMethodHash":"faf7b30bdafa1dd5767d01103ce02b38","calleeDisplayName":"Aimmy2.AILogic.PerformanceRecommendationBuilder.BuildFpsCap(Aimmy2.AILogic.PerformanceBenchmarkSizeResult, Aimmy2.AILogic.PerformanceGoal)"},{"span":{"startLine":933,"startColumn":17,"endLine":933,"endColumn":45},"calleeMethodHash":"e7682ec2967f8d83859b597de48d26aa","calleeDisplayName":"Visuality.PerformanceHelperWindow.GetSelectedMode(Aimmy2.AILogic.PerformanceGoal)"}]},"lines":["        private static PerformanceRecommendation CreateSelectionRecommendation(","            PerformanceBenchmarkSizeResult result,","            PerformanceBenchmarkReport report)","        {","            var knownRecommendation = GetMatchingRecommendation(result, report);","            if (knownRecommendation != null)","            {","                return knownRecommendation with","                {","                    CanChangeImageSize = !report.IsFixedSizeModel \u0026\u0026 result.ImageSize != AimSettings.ImageSize","                };","            }","","            bool canChangeImageSize = !report.IsFixedSizeModel \u0026\u0026 result.ImageSize != AimSettings.ImageSize;","            string summary = report.IsFixedSizeModel","                ? \u0022Fixed model locks image size. FPS cap still cuts heat.\u0022","                : result.ImageSize \u003C AimSettings.ImageSize","                    ? \u0022Lower image size cuts load. Small or far targets can lose detail.\u0022","                    : result.ImageSize \u003E AimSettings.ImageSize","                        ? \u0022Higher image size can improve detail but costs more load.\u0022","                        : \u0022Keep image size. FPS cap cuts extra CPU/GPU work.\u0022;","","            return new PerformanceRecommendation(","                result.ImageSize,","                PerformanceRecommendationBuilder.BuildFpsCap(result, report.Goal),","                canChangeImageSize,","                summary,","                \u0022Selected\u0022,","                GetSelectedMode(report.Goal));","        }"],"startLine":905}
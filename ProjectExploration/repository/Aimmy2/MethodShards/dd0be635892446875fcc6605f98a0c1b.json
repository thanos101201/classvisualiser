{"method":{"methodHash":"dd0be635892446875fcc6605f98a0c1b","typeHash":"e212d1e8cf791118b97599dbc2bd3f34","name":"RgbToHsv","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/UILibrary/AColorWheel.xaml.cs","bodySpan":{"startLine":377,"startColumn":9,"endLine":416,"endColumn":10},"calls":[{"span":{"startLine":383,"startColumn":26,"endLine":383,"endColumn":53},"calleeMethodHash":null,"calleeDisplayName":"Max"},{"span":{"startLine":383,"startColumn":38,"endLine":383,"endColumn":52},"calleeMethodHash":null,"calleeDisplayName":"Max"},{"span":{"startLine":384,"startColumn":26,"endLine":384,"endColumn":53},"calleeMethodHash":null,"calleeDisplayName":"Min"},{"span":{"startLine":384,"startColumn":38,"endLine":384,"endColumn":52},"calleeMethodHash":null,"calleeDisplayName":"Min"}]},"lines":["        private void RgbToHsv(Color color, out double hue, out double saturation, out double value)","        {","            double r = color.R / 255.0;","            double g = color.G / 255.0;","            double b = color.B / 255.0;","","            double max = Math.Max(r, Math.Max(g, b));","            double min = Math.Min(r, Math.Min(g, b));","            double delta = max - min;","","            // Value","            value = max;","","            // Saturation","            if (max == 0)","                saturation = 0;","            else","                saturation = delta / max;","","            // Hue","            if (delta == 0)","            {","                hue = 0;","            }","            else if (max == r)","            {","                hue = 60 * (((g - b) / delta) % 6);","            }","            else if (max == g)","            {","                hue = 60 * (((b - r) / delta) \u002B 2);","            }","            else","            {","                hue = 60 * (((r - g) / delta) \u002B 4);","            }","","            if (hue \u003C 0)","                hue \u002B= 360;","        }"],"startLine":377}
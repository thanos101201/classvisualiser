{"method":{"methodHash":"32129618979b8cbb3cfe4741b5fb08ce","typeHash":"62a0cd3fd27318a7b08ca5fb531b3db2","name":"CalculateSmoothedAngle","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/MainWindow.xaml.cs","bodySpan":{"startLine":1048,"startColumn":9,"endLine":1060,"endColumn":10},"calls":[{"span":{"startLine":1058,"startColumn":37,"endLine":1058,"endColumn":87},"calleeMethodHash":null,"calleeDisplayName":"Max"},{"span":{"startLine":1058,"startColumn":46,"endLine":1058,"endColumn":78},"calleeMethodHash":null,"calleeDisplayName":"Min"}]},"lines":["        private double CalculateSmoothedAngle(double targetAngle)","        {","            const double fullCircle = 360;","            const double halfCircle = 180;","            const double clamp = 1;","","            var angleDifference = (targetAngle - _currentGradientAngle \u002B fullCircle) % fullCircle;","            if (angleDifference \u003E halfCircle)","                angleDifference -= fullCircle;","","            var clampedDifference = Math.Max(Math.Min(angleDifference, clamp), -clamp);","            return (_currentGradientAngle \u002B clampedDifference \u002B fullCircle) % fullCircle;","        }"],"startLine":1048}
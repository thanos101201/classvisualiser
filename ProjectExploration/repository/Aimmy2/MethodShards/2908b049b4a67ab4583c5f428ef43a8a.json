{"method":{"methodHash":"2908b049b4a67ab4583c5f428ef43a8a","typeHash":"62a0cd3fd27318a7b08ca5fb531b3db2","name":"ApplyDropdownValues","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/MainWindow.xaml.cs","bodySpan":{"startLine":1375,"startColumn":9,"endLine":1392,"endColumn":10},"calls":[{"span":{"startLine":1379,"startColumn":41,"endLine":1379,"endColumn":79},"calleeMethodHash":null,"calleeDisplayName":"TryGetValue"},{"span":{"startLine":1381,"startColumn":45,"endLine":1381,"endColumn":56},"calleeMethodHash":null,"calleeDisplayName":".ToString"},{"span":{"startLine":1382,"startColumn":25,"endLine":1382,"endColumn":73},"calleeMethodHash":null,"calleeDisplayName":"TryGetValue"},{"span":{"startLine":1388,"startColumn":25,"endLine":1388,"endColumn":130},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"}]},"lines":["        private void ApplyDropdownValues((string key, ADropdown? dropdown, Dictionary\u003Cstring, int\u003E mappings)[] configs, Dictionary\u003Cstring, dynamic\u003E source)","        {","            foreach (var (key, dropdown, mappings) in configs)","            {","                if (dropdown != null \u0026\u0026 source.TryGetValue(key, out var value))","                {","                    var stringValue = value?.ToString() ?? \u0022\u0022;","                    if (mappings.TryGetValue(stringValue, out int index))","                    {","                        dropdown.DropdownBox.SelectedIndex = index;","                    }","                    else","                    {","                        LogManager.Log(LogManager.LogLevel.Warning, $\u0022No mapping found for \u0027{stringValue}\u0027 in \u0027{key}\u0027 dropdown.\u0022);","                    }","                }","            }","        }"],"startLine":1375}
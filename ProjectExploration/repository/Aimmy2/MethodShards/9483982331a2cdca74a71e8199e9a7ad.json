{"method":{"methodHash":"9483982331a2cdca74a71e8199e9a7ad","typeHash":"964fda6e13e37c90a6a3ead912fb06b0","name":"Adaptive","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/InputLogic/MovementPaths.cs","bodySpan":{"startLine":35,"startColumn":9,"endLine":48,"endColumn":10},"calls":[{"span":{"startLine":37,"startColumn":31,"endLine":37,"endColumn":101},"calleeMethodHash":null,"calleeDisplayName":"Sqrt"},{"span":{"startLine":37,"startColumn":41,"endLine":37,"endColumn":69},"calleeMethodHash":null,"calleeDisplayName":"Pow"},{"span":{"startLine":37,"startColumn":72,"endLine":37,"endColumn":100},"calleeMethodHash":null,"calleeDisplayName":"Pow"},{"span":{"startLine":40,"startColumn":24,"endLine":40,"endColumn":43},"calleeMethodHash":"d441eb5d2a2f70854456287c1e4fee5b","calleeDisplayName":"InputLogic.MovementPaths.Lerp(System.Drawing.Point, System.Drawing.Point, double)"},{"span":{"startLine":46,"startColumn":24,"endLine":46,"endColumn":70},"calleeMethodHash":"c55773273761dc4e556d6aaf20b13651","calleeDisplayName":"InputLogic.MovementPaths.CubicBezier(System.Drawing.Point, System.Drawing.Point, System.Drawing.Point, System.Drawing.Point, double)"}]},"lines":["        internal static Point Adaptive(Point start, Point end, double t, double threshold = 100.0)","        {","            double distance = Math.Sqrt(Math.Pow(end.X - start.X, 2) \u002B Math.Pow(end.Y - start.Y, 2));","            if (distance \u003C threshold)","            {","                return Lerp(start, end, t);","            }","            else","            {","                Point control1 = new Point(start.X \u002B (end.X - start.X) / 3, start.Y \u002B (end.Y - start.Y) / 3);","                Point control2 = new Point(start.X \u002B 2 * (end.X - start.X) / 3, start.Y \u002B 2 * (end.Y - start.Y) / 3);","                return CubicBezier(start, end, control1, control2, t);","            }","        }"],"startLine":35}
{"method":{"methodHash":"e301162e11f3ed6cf70fc679c480c7a6","typeHash":"a1187cb73a1ff700ea5de23d79493f36","name":"UpdateCentralGlow","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/StartupWindow.xaml.cs","bodySpan":{"startLine":149,"startColumn":9,"endLine":167,"endColumn":10},"calls":[{"span":{"startLine":151,"startColumn":19,"endLine":151,"endColumn":78},"calleeMethodHash":null,"calleeDisplayName":"FindLogicalNode"}]},"lines":["        private void UpdateCentralGlow(Color baseColor)","        {","            if (!(LogicalTreeHelper.FindLogicalNode(this, \u0022LoadingIndicator\u0022) is Grid loadingGrid))","                return;","","            var parent = loadingGrid.Parent as StackPanel;","            var mainGrid = parent?.Parent as Grid;","            if (mainGrid == null) return;","","            foreach (var child in mainGrid.Children)","            {","                if (child is Ellipse { Width: 40, Height: 40 } ellipse \u0026\u0026","                    ellipse.Effect is BlurEffect)","                {","                    ellipse.Fill = new SolidColorBrush(baseColor);","                    break;","                }","            }","        }"],"startLine":149}
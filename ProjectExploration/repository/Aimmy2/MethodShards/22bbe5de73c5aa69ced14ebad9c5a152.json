{"method":{"methodHash":"22bbe5de73c5aa69ced14ebad9c5a152","typeHash":"32dcfd1d62834e6a7a2852258e01a2ac","name":"UpdatePosition","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/PredictionManager.cs","bodySpan":{"startLine":233,"startColumn":9,"endLine":260,"endColumn":10},"calls":[{"span":{"startLine":250,"startColumn":17,"endLine":250,"endColumn":46},"calleeMethodHash":null,"calleeDisplayName":"RemoveAt"},{"span":{"startLine":251,"startColumn":17,"endLine":251,"endColumn":46},"calleeMethodHash":null,"calleeDisplayName":"RemoveAt"},{"span":{"startLine":254,"startColumn":13,"endLine":254,"endColumn":45},"calleeMethodHash":null,"calleeDisplayName":"Add"},{"span":{"startLine":255,"startColumn":13,"endLine":255,"endColumn":45},"calleeMethodHash":null,"calleeDisplayName":"Add"}]},"lines":["        public static void UpdatePosition(int targetX, int targetY)","        {","            if (!_initialized)","            {","                _prevX = targetX;","                _prevY = targetY;","                _initialized = true;","                return;","            }","","            // Calculate velocity (pixels per frame)","            int velocityX = targetX - _prevX;","            int velocityY = targetY - _prevY;","","            // Add to history, removing oldest if full","            if (_velocityXHistory.Count \u003E= MaxHistorySize)","            {","                _velocityXHistory.RemoveAt(0);","                _velocityYHistory.RemoveAt(0);","            }","","            _velocityXHistory.Add(velocityX);","            _velocityYHistory.Add(velocityY);","","            // Store current position for next frame","            _prevX = targetX;","            _prevY = targetY;","        }"],"startLine":233}
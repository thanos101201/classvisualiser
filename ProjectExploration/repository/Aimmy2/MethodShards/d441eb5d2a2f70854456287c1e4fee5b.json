{"method":{"methodHash":"d441eb5d2a2f70854456287c1e4fee5b","typeHash":"964fda6e13e37c90a6a3ead912fb06b0","name":"Lerp","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/InputLogic/MovementPaths.cs","bodySpan":{"startLine":21,"startColumn":9,"endLine":26,"endColumn":10},"calls":[]},"lines":["        internal static Point Lerp(Point start, Point end, double t)","        {","            int x = (int)(start.X \u002B (end.X - start.X) * t);","            int y = (int)(start.Y \u002B (end.Y - start.Y) * t);","            return new Point(x, y);","        }"],"startLine":21}
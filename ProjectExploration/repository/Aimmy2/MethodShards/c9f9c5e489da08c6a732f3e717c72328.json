ack to CPU, performance may be poor.\u0022, true);","","                    try","                    {","                        bool loaded = await LoadModelAsync(modelPath, useDirectML: false);","                        _usingDirectML = loaded ? false : _usingDirectML;","                        return loaded;","                    }","                    catch (Exception e)","                    {","                        Log(LogLevel.Error, $\u0022Error starting the model via CPU: {e.Message}, you won\u0027t be able to aim assist at all.\u0022, true);","                        return false;","                    }","                }","            }","        }"],"startLine":229}
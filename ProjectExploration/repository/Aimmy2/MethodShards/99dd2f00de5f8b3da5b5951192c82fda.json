         // Only allow image formats","                    if (extension == \u0022.png\u0022 || extension == \u0022.jpg\u0022 || extension == \u0022.jpeg\u0022)","                    {","                        LoadMediaPreview(filePath);","                    }","                    else","                    {","                        new NoticeBar(\u0022Error: Only PNG/JPG/JPEG images are supported\u0022, 3000).Show();","                    }","","                    e.Handled = true;","                    return;","                }","            }","","            e.Handled = true;","        }"],"startLine":500}
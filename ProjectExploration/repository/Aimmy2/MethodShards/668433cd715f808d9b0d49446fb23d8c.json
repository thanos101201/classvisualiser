{"method":{"methodHash":"668433cd715f808d9b0d49446fb23d8c","typeHash":"2ca9d5d2b01a9292fa204f5df7b8e46f","name":"CalculateTargetScore","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/MathUtil.cs","bodySpan":{"startLine":28,"startColumn":9,"endLine":60,"endColumn":10},"calls":[{"span":{"startLine":45,"startColumn":35,"endLine":45,"endColumn":76},"calleeMethodHash":null,"calleeDisplayName":"Max"},{"span":{"startLine":52,"startColumn":31,"endLine":52,"endColumn":60},"calleeMethodHash":null,"calleeDisplayName":"Min"}]},"lines":["        [MethodImpl(MethodImplOptions.AggressiveInlining)]","        public static float CalculateTargetScore(","            Prediction candidate,","            Prediction? currentTarget,","            float predictedX,","            float predictedY,","            float currentLockScore,","            float maxLockScore,","            float threshold)","        {","            // Base score from distance to predicted position (where we expect current target to be)","            float dx = candidate.ScreenCenterX - predictedX;","            float dy = candidate.ScreenCenterY - predictedY;","            float distSq = dx * dx \u002B dy * dy;","","            // Normalize distance score (0 = far, 1 = close)","            float thresholdSq = threshold * threshold;","            float distanceScore = Math.Max(0f, 1f - (distSq / thresholdSq));","","            // Confidence bonus (0-0.3 range)","            float confidenceBonus = candidate.Confidence * 0.3f;","","            // Size bonus - larger targets are more stable (0-0.2 range)","            float area = candidate.Rectangle.Width * candidate.Rectangle.Height;","            float sizeBonus = Math.Min(0.2f, area / 50000f);","","            // Lock bonus for current target (0-0.5 range based on accumulated score)","            float lockBonus = (currentTarget != null \u0026\u0026 distanceScore \u003E 0.3f)","                ? (currentLockScore / maxLockScore) * 0.5f","                : 0f;","","            return distanceScore \u002B confidenceBonus \u002B sizeBonus \u002B lockBonus;","        }"],"startLine":28}
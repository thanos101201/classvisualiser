{"method":{"methodHash":"7a15226972f756826cf689efae27aa73","typeHash":"e26486f9fb3b532a75fbd7f41699ff2f","name":"SaveFrame","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/AILogic/AIManager.cs","bodySpan":{"startLine":1515,"startColumn":9,"endLine":1566,"endColumn":10},"calls":[{"span":{"startLine":1540,"startColumn":31,"endLine":1540,"endColumn":56},"calleeMethodHash":null,"calleeDisplayName":"ToString"},{"span":{"startLine":1540,"startColumn":31,"endLine":1540,"endColumn":45},"calleeMethodHash":null,"calleeDisplayName":"NewGuid"},{"span":{"startLine":1541,"startColumn":36,"endLine":1541,"endColumn":80},"calleeMethodHash":null,"calleeDisplayName":"Combine"},{"span":{"startLine":1544,"startColumn":17,"endLine":1544,"endColumn":56},"calleeMethodHash":null,"calleeDisplayName":"Save"},{"span":{"startLine":1548,"startColumn":37,"endLine":1548,"endColumn":81},"calleeMethodHash":null,"calleeDisplayName":"Combine"},{"span":{"startLine":1555,"startColumn":21,"endLine":1555,"endColumn":106},"calleeMethodHash":null,"calleeDisplayName":"WriteAllText"},{"span":{"startLine":1564,"startColumn":17,"endLine":1564,"endColumn":71},"calleeMethodHash":"54c102711f6174b42f30ed43a50c4fad","calleeDisplayName":"Other.LogManager.Log(Other.LogManager.LogLevel, string, bool, int)"}]},"lines":["        private void SaveFrame(Bitmap frame, Prediction? DoLabel = null)","        {","            if (_suppressOutputActions)","                return;","","            // Only save frames if \u0022Collect Data While Playing\u0022 is enabled","            if (!AimSettings.CollectDataWhilePlaying) return;","","            // Skip if we\u0027re in constant tracking mode (unless auto-labeling is enabled)","            if (AimSettings.ConstantAiTracking \u0026\u0026 !AimSettings.AutoLabelData) return;","","            // Cooldown check","            if ((DateTime.Now - lastSavedTime).TotalMilliseconds \u003C SAVE_FRAME_COOLDOWN_MS) return;","","            try","            {","                // Validate bitmap is still usable","                if (frame == null) return;","","                // Accessing Width/Height will throw if bitmap is disposed","                int width = frame.Width;","                int height = frame.Height;","                if (width \u003C= 0 || height \u003C= 0) return;","","                lastSavedTime = DateTime.Now;","                string uuid = Guid.NewGuid().ToString();","                string imagePath = Path.Combine(\u0022bin\u0022, \u0022images\u0022, $\u0022{uuid}.jpg\u0022);","","                // Save synchronously to avoid \u0022Object is currently in use elsewhere\u0022 error","                frame.Save(imagePath, ImageFormat.Jpeg);","","                if (AimSettings.AutoLabelData \u0026\u0026 DoLabel != null)","                {","                    var labelPath = Path.Combine(\u0022bin\u0022, \u0022labels\u0022, $\u0022{uuid}.txt\u0022);","","                    float x = (DoLabel!.Rectangle.X \u002B DoLabel.Rectangle.Width / 2) / width;","                    float y = (DoLabel!.Rectangle.Y \u002B DoLabel.Rectangle.Height / 2) / height;","                    float labelWidth = DoLabel.Rectangle.Width / width;","                    float labelHeight = DoLabel.Rectangle.Height / height;","","                    File.WriteAllText(labelPath, $\u0022{DoLabel.ClassId} {x} {y} {labelWidth} {labelHeight}\u0022);","                }","            }","            catch (ArgumentException)","            {","                // Bitmap was disposed or invalid - silently ignore","            }","            catch (Exception ex)","            {","                Log(LogLevel.Error, $\u0022SaveFrame failed: {ex.Message}\u0022);","            }","        }"],"startLine":1515}
{"method":{"methodHash":"f253248de09cb72fcc9e7dbc2a7a0a91","typeHash":"04cf9082c67af9721ed15a114ae70c8c","name":"LoadJSON","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/Class/SaveDictionary.cs","bodySpan":{"startLine":63,"startColumn":9,"endLine":108,"endColumn":10},"calls":[{"span":{"startLine":68,"startColumn":37,"endLine":68,"endColumn":64},"calleeMethodHash":null,"calleeDisplayName":"GetDirectoryName"},{"span":{"startLine":69,"startColumn":22,"endLine":69,"endColumn":53},"calleeMethodHash":null,"calleeDisplayName":"IsNullOrEmpty"},{"span":{"startLine":69,"startColumn":58,"endLine":69,"endColumn":85},"calleeMethodHash":null,"calleeDisplayName":"Exists"},{"span":{"startLine":71,"startColumn":21,"endLine":71,"endColumn":57},"calleeMethodHash":null,"calleeDisplayName":"CreateDirectory"},{"span":{"startLine":74,"startColumn":22,"endLine":74,"endColumn":39},"calleeMethodHash":null,"calleeDisplayName":"Exists"},{"span":{"startLine":76,"startColumn":21,"endLine":76,"endColumn":48},"calleeMethodHash":"66d31cb63bc8dd1448f93992ce8dd651","calleeDisplayName":"Class.SaveDictionary.WriteJSON(System.Collections.Generic.Dictionary\u003Cstring, dynamic\u003E, string, string, string)"},{"span":{"startLine":80,"startColumn":37,"endLine":80,"endColumn":119},"calleeMethodHash":null,"calleeDisplayName":"DeserializeObject\u003CDictionary\u003Cstring, dynamic\u003E\u003E"},{"span":{"startLine":80,"startColumn":96,"endLine":80,"endColumn":118},"calleeMethodHash":null,"calleeDisplayName":"ReadAllText"},{"span":{"startLine":85,"startColumn":25,"endLine":85,"endColumn":52},"calleeMethodHash":null,"calleeDisplayName":"ContainsKey"},{"span":{"startLine":91,"startColumn":25,"endLine":91,"endColumn":51},"calleeMethodHash":null,"calleeDisplayName":"Add"},{"span":{"startLine":100,"startColumn":21,"endLine":100,"endColumn":48},"calleeMethodHash":"66d31cb63bc8dd1448f93992ce8dd651","calleeDisplayName":"Class.SaveDictionary.WriteJSON(System.Collections.Generic.Dictionary\u003Cstring, dynamic\u003E, string, string, string)"},{"span":{"startLine":105,"startColumn":21,"endLine":105,"endColumn":90},"calleeMethodHash":null,"calleeDisplayName":"Show"},{"span":{"startLine":105,"startColumn":76,"endLine":105,"endColumn":89},"calleeMethodHash":null,"calleeDisplayName":"ToString"}]},"lines":["        public static void LoadJSON(Dictionary\u003Cstring, dynamic\u003E dictionary, string path = \u0022bin\\\\configs\\\\Default.cfg\u0022, bool strict = true)","        {","            try","            {","                // Ensure the directory exists before checking for the file","                string? directory = Path.GetDirectoryName(path);","                if (!string.IsNullOrEmpty(directory) \u0026\u0026 !Directory.Exists(directory))","                {","                    Directory.CreateDirectory(directory);","                }","","                if (!File.Exists(path))","                {","                    WriteJSON(dictionary, path);","                    return;","                }","","                var configuration = JsonConvert.DeserializeObject\u003CDictionary\u003Cstring, dynamic\u003E\u003E(File.ReadAllText(path));","                if (configuration == null) return;","","                foreach (var (key, value) in configuration)","                {","                    if (dictionary.ContainsKey(key))","                    {","                        dictionary[key] = value;","                    }","                    else if (!strict)","                    {","                        dictionary.Add(key, value);","                    }","                }","            }","            catch (Exception ex)","            {","                // If there\u0027s an error loading, try to recreate the file with defaults","                try","                {","                    WriteJSON(dictionary, path);","                }","                catch","                {","                    // Only show error if we can\u0027t even create a default file","                    MessageBox.Show(\u0022Error loading JSON, please note:\\n\u0022 \u002B ex.ToString());","                }","            }","        }"],"startLine":63}
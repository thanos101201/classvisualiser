{"method":{"methodHash":"8a878b6d38a8ddf204cd4e4a24054ba5","typeHash":"a1187cb73a1ff700ea5de23d79493f36","name":"GenerateParticlePosition","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/StartupWindow.xaml.cs","bodySpan":{"startLine":206,"startColumn":9,"endLine":230,"endColumn":10},"calls":[{"span":{"startLine":221,"startColumn":35,"endLine":221,"endColumn":55},"calleeMethodHash":null,"calleeDisplayName":"NextDouble"},{"span":{"startLine":222,"startColumn":35,"endLine":222,"endColumn":55},"calleeMethodHash":null,"calleeDisplayName":"NextDouble"},{"span":{"startLine":224,"startColumn":22,"endLine":224,"endColumn":53},"calleeMethodHash":"73ab698e00cd50323da492da06277019","calleeDisplayName":"Aimmy2.StartupWindow.IsInExclusionZone(double, double, Point)"},{"span":{"startLine":229,"startColumn":20,"endLine":229,"endColumn":55},"calleeMethodHash":"effb8a8d179f677d16daf71abd8ac3e0","calleeDisplayName":"Aimmy2.StartupWindow.GetCornerPosition(double, double)"}]},"lines":["        private Point GenerateParticlePosition()","        {","            double containerWidth = ActualWidth \u003E 0 ? ActualWidth : _targetWidth;","            double containerHeight = ActualHeight \u003E 0 ? ActualHeight : _targetHeight;","            double offsetX = (containerWidth - VISIBLE_WINDOW_SIZE) / 2;","            double offsetY = (containerHeight - VISIBLE_WINDOW_SIZE) / 2;","","            var center = new Point(","                offsetX \u002B VISIBLE_WINDOW_SIZE / 2,","                offsetY \u002B VISIBLE_WINDOW_SIZE / 2","            );","","            // Try to find position outside exclusion zone","            for (int attempts = 0; attempts \u003C 30; attempts\u002B\u002B)","            {","                var x = offsetX \u002B _random.NextDouble() * (VISIBLE_WINDOW_SIZE - 40) \u002B 20;","                var y = offsetY \u002B _random.NextDouble() * (VISIBLE_WINDOW_SIZE - 40) \u002B 20;","","                if (!IsInExclusionZone(x, y, center))","                    return new Point(x, y);","            }","","            // Fallback to corner placement","            return GetCornerPosition(offsetX, offsetY);","        }"],"startLine":206}
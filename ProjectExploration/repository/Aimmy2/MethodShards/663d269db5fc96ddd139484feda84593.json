u0022, (Action\u003Cobject\u003E)(o =\u003E PropertyChanger.PostDPWOpacity((double)o)))","            };","","            foreach (var (key, action) in dpSettings)","            {","                if (key.Contains(\u0022Color\u0022))","                {","                    action(ColorConverter.ConvertFromString(Dictionary.colorState[key].ToString()));","                }","                else","                {","                    action(Convert.ToDouble(Dictionary.sliderSettings[key]));","                }","            }","        }"],"startLine":275}
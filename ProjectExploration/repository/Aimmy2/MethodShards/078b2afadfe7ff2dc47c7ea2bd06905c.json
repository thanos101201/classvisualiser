{"method":{"methodHash":"078b2afadfe7ff2dc47c7ea2bd06905c","typeHash":"a1187cb73a1ff700ea5de23d79493f36","name":"UpdateFadeTransition","filePath":"/Users/pratiksinghthakur/perproj/dotnet/Aimmy/Aimmy2/StartupWindow.xaml.cs","bodySpan":{"startLine":417,"startColumn":9,"endLine":435,"endColumn":10},"calls":[{"span":{"startLine":421,"startColumn":35,"endLine":421,"endColumn":110},"calleeMethodHash":null,"calleeDisplayName":"Min"},{"span":{"startLine":422,"startColumn":35,"endLine":422,"endColumn":63},"calleeMethodHash":"14e0f95703f4a4bf67ec9bcfe9b9fedc","calleeDisplayName":"Aimmy2.StartupWindow.EaseInOutQuart(double)"},{"span":{"startLine":425,"startColumn":37,"endLine":425,"endColumn":79},"calleeMethodHash":null,"calleeDisplayName":"Max"},{"span":{"startLine":425,"startColumn":53,"endLine":425,"endColumn":78},"calleeMethodHash":null,"calleeDisplayName":"Pow"},{"span":{"startLine":433,"startColumn":39,"endLine":433,"endColumn":65},"calleeMethodHash":"bc0c2e8306d19c0a0d310522c704b7dc","calleeDisplayName":"Aimmy2.StartupWindow.EaseOutQuint(double)"}]},"lines":["        private void UpdateFadeTransition(double progress)","        {","            if (progress \u003C= FADE_START_PROGRESS) return;","","            double fadeProgress = Math.Min((progress - FADE_START_PROGRESS) / (1 - FADE_START_PROGRESS), 1.0);","            double smoothedFade = EaseInOutQuart(fadeProgress);","","            // Fade out startup window","            double startupOpacity = Math.Max(0, 1 - Math.Pow(smoothedFade, 3));","            ContentContainer.Opacity = startupOpacity;","            Opacity = startupOpacity;","","            // Fade in main window","            if (_mainWindow != null \u0026\u0026 fadeProgress \u003E MAIN_WINDOW_FADE_DELAY)","            {","                double mainProgress = (fadeProgress - MAIN_WINDOW_FADE_DELAY) / (1 - MAIN_WINDOW_FADE_DELAY);","                _mainWindow.Opacity = EaseOutQuint(mainProgress);","            }","        }"],"startLine":417}
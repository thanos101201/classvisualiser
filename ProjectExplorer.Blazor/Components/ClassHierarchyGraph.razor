@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@_containerId" class="hierarchy-graph"></div>

@code {
    [Parameter, EditorRequired]
    public GraphData Data { get; set; } = null!;

    private readonly string _containerId = $"graph-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private GraphData? _lastRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hierarchyGraph.js");

        if (!ReferenceEquals(_lastRendered, Data))
        {
            await _module.InvokeVoidAsync("renderGraph", _containerId, Data);
            _lastRendered = Data;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("destroyGraph", _containerId);
            await _module.DisposeAsync();
        }
    }
}
